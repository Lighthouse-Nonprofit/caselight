# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
tmp
# public/ children are ignored (compiled assets, carrierwave uploads) EXCEPT the
# curated static dirs the app references by absolute path (R9b fonts/sprites, R13
# spinner, R12B mi18n lang file). NB the old blanket `/public` rule meant those
# statics were NEVER tracked — dev worked from local files while every fresh
# checkout (CI, a box redeploy) would have 404'd them. Caught by the R12B guard
# spec failing on CI (public/fb-lang missing on the runner).
/public/*
!/public/fonts/
!/public/images/
!/public/fb-lang/
.env
.env.test
.env.development
dump.rdb
# For Mac OS only
.DS_Store
dump.rdb
vendor/data
.seeded
.env.*
!.env.example

# dart-sass build output (dartsass:build); only .keep is committed
/app/assets/builds/*
!/app/assets/builds/.keep
