= simple_form_for(agency ||= Agency.new) do |f|
  .modal.fade{id: "agencyModal-#{agency.id}", "aria-labelledby" => "agencyModal-#{agency.id}Label", :role => "dialog", :tabindex => "-1"}
    .modal-dialog{:role => "document"}
      .modal-content
        .modal-header
          %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
          %h4.modal-title{ id: "agencyModal-#{agency.id}Label" }= t('.agency')
        .modal-body
          = error_notification(f)
          .form-inputs
            = f.input :name, label: t('.name')
            = f.input :description, input_html: { rows: '10' }, label: t('.description')
            -# D1: which programs this agency partners on (multi-select; CIF.Select enhances)
            = f.association :program_streams, collection: ProgramStream.order(:name), label: t('.programs', default: 'Programs'), input_html: { multiple: true }
        .modal-footer
          .float-start
            = f.submit t('.save') , class: 'btn btn-primary form-btn'
            %button.btn.btn-outline-secondary{"data-bs-dismiss" => "modal", :type => "button"}= t('.cancel')
