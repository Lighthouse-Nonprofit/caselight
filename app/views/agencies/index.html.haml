.row
  .col-12
    .ibox
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.agency')
        .ibox-tools
          - if can? :manage, Agency
            = link_to '#', {"data-bs-target" => "#agencyModal-", "data-bs-toggle" => "modal", :type => "button"} do
              .btn.btn-primary.btn-add
                = t('.add_new_agency')
      .ibox-content
        .table-responsive
          %table.table.table-bordered.table-striped.table-hover
            %thead
              %tr
                %th.custom_column_name= t('.agency_names')
                %th.custom_column_description= t('.description')
                %th.custom_column_programs= t('.programs', default: 'Programs')
                %th.custom_column_clients= t('.clients', default: 'Individuals')
                - if can? :manage, Agency
                  %th.text-center.custom_column_manage{ colspan: '2' }= t('.manage')
                - if can? :version, Agency
                  %th.changelog.text-center= t('.changelogs')
            %tbody
              - @agencies.each do |agency|
                %tr
                  %td
                    -# D1: the name filters the individuals grid to this agency's people
                    = link_to agency.name, clients_path(client_grid: { agencies_name: [agency.name] })
                  %td= agency.description
                  %td
                    -# D1: programs this agency partners on
                    - agency.program_streams.order(:name).each do |program_stream|
                      %span.badge.text-bg-light
                        = link_to program_stream.name, program_stream_path(program_stream)
                  %td
                    -# Investor UX round (2026-07): linked individuals, mirroring donors#index.
                    -# accessible_by-SCOPED: this index is reachable by every role, so a
                    -# case worker sees only their own caseload here (leak guard).
                    - agency.clients.accessible_by(current_ability).each do |client|
                      %strong.badge.text-bg-light.client
                        = link_to entity_name(client), client_path(client)
                  - if can? :manage, Agency
                    %td.text-center
                      = link_to '#', {class: 'btn btn-outline btn-success btn-xs', "data-bs-target" => "#agencyModal-#{agency.id}", "data-bs-toggle" => "modal", :type => "button"} do
                        = fa_icon('pencil')
                    %td.text-center
                      = remove_link(agency, { agency_client: agency.clients.size })
                  - if can? :read, Agency
                    %td.text-center
                      = link_to t('.view'), agency_version_path(agency)
                  - if can? :manage, Agency
                    = render 'form', agency: agency
        .ibox-footer.text-center
          = paginate @agencies
= render 'form'
