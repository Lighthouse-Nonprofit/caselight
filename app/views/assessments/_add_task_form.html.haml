.modal.fade{ role: 'dialog', tabindex: '-1', id: "tasksFromModal"}
  .modal-dialog{ role: 'document'}
    .modal-content
      .modal-header
        %button.btn-close{"aria-label" => 'Close', "data-bs-dismiss" => 'modal'}
        %h4.modal-title
          = t('.title')
      .modal-body
        = form_tag(client_tasks_path(@client), name: 'task', id: 'assessment_domain_task') do
          = hidden_field :task, 'domain_id', class: 'form-control'

          .mb-3.required.task_name
            %label.date.required.form-label{ for: 'task_name' }
              %abbr{ title: 'required' } *
              = t('.enter_task_detail')
            = text_field :task, 'name', class: 'form-control'
            %span.form-text.task_name_help


          .mb-3.date.required.task_completion_date
            %label.date.required.form-label{ for: 'task_completion_date' }
              %abbr{ title: 'required' } *
              = t('.completion_date')
            .input-group.date
              = text_field :task, :completion_date, class: 'date required form-control date-picker', id: 'task_completion_date'
              %span.input-group-text
                %i.fa.fa-calendar-check-o
            %span.form-text.task_completion_date_help

          = button_tag t('.save'), type: 'button', class: 'btn btn-primary add-task-btn'