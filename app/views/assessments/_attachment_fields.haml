- attachments = ad.object.attachments
- if attachments.present?
  .row
    .col-12
      .table-responsive
        %table.table.table-bordered.table-hover.attachment-table
          %tbody.assessment_domain
            - attachments.each_with_index do |attachment, index|
              %tr.row-file
                %td.image-title.vert-align
                  = original_filename(attachment)
                %td.vert-align
                  -# Raw attachment.url points into /uploads/**, which the uploads guard 403s for
                  -# everyone — serve through the authorized, domain-sensitivity-gated route the
                  -# show page already uses (POAM-013 dead-link fix).
                  = link_to preview_or_download(attachment), download_attachment_client_assessment_path(@assessment.client, @assessment, assessment_domain_id: ad.object.id, index: index), class: 'btn btn-info btn-sm btn-download', target: target_blank(attachment)
                %td.vert-align.text-center
                  .delete.fa.fa-trash.btn.btn-outline.btn-danger{ data: { url: (client_assessment_path(@assessment.client, @assessment, assessment_domain: ad.object, file_index: index)), comfirm: t('.are_you_sure') }}
.row
  .col-12
    = ad.input :attachments, label: t('.attachments'), as: :file, input_html: { multiple: true }
