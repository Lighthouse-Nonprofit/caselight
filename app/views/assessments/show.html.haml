.row
  .col-12
    = link_to client_assessments_path(@assessment.client), class: 'btn btn-outline-secondary' do
      = t('.back_to_assessment_history')
.row.mini-margin
  .col-12
    .ibox
      .ibox-title
        .row
          .col-12
            - if @assessment.initial?
              = t('.initial_assessment_of')
            - else
              = t('.six_month_assessment_report')
            %strong
              %u= @assessment.client.name
          .col-12
            %span= t('.assessment_completed_by')
            %strong
              %u= @assessment.client.users.map{|u| u.first_name }.join(' & ')
            %span= t('.on_date')
            %strong
              %u= @assessment.created_at.strftime("%B %d, %Y")
            %span.float-end.margin-asse
              - if @assessment.latest_record?
                - if can? :update, @assessment
                  = link_to edit_client_assessment_path(@assessment.client, @assessment) do
                    .btn.btn-outline.btn-success
                      %i.fa.fa-pencil
      .ibox-content
        .table-responsive
          %table.table.table-bordered
            %tbody
              - @assessment.assessment_domains_in_order.each do |ad|
                %tr
                  %td.domain-detail
                    .domain-identity
                      %span
                        = "#{t('.domain')} #{ad.domain.name}:"
                      %strong
                        = ad.domain.identity
                    - if domain_visible?(ad.domain)
                      .domain-score
                        %span= t('.score')
                        - unless @assessment.initial?
                          %span{ class: "badge text-bg-#{ad.previous_score_color_class} "}
                            = "#{ad.previous_score}"
                          %span &#8594;
                        %span{ class: "badge text-bg-#{ad.score_color_class} "}
                          = "#{ad.score}"
                  - if domain_visible?(ad.domain)
                    %td.reason
                      %p
                        %strong= "#{t('.reason')}:"
                        %span= ad.reason
                      %p
                        %strong= "#{t('.goal')}:"
                        %span= ad.try(:goal)
                      - incomplete_tasks = @client.tasks.by_domain_id(ad.domain_id).incomplete
                      - if incomplete_tasks.any?
                        %p
                          %strong= "#{t('.task')}:"
                          %ul
                            - incomplete_tasks.each do |task|
                              %li= task.name
                      - if ad.attachments.any?
                        %button.btn.btn-info.btn-sm{"data-bs-target" => "#attachments#{ad.id}", "data-bs-toggle" => "modal", :type => "button"}= t('.show_attachment')
                        = render 'attachment', { ad: ad }
                  - else
                    %td.reason.text-muted
                      = restricted_masked_notice
