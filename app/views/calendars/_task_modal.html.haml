-# Date-click task-creation modal for the calendar (SLO4HOME revision, Workstream B2;
-# FLIPPED per the owner 2026-07-31: Person -> Program, not Program -> Person).
-# Person (server-rendered: accessible_by + active-enrolled — the security boundary) ->
-# Program (AJAX from /api/calendars/client_programs, that person's active programs;
-# contextual — the task itself attaches to the person) -> Domain (required) -> Task ->
-# date (prefilled from the click). Behavior lives in calendars/index.js (no inline JS — CSP-safe).
#taskModal.modal.fade{ tabindex: '-1', role: 'dialog', 'aria-labelledby' => 'taskModalLabel', 'aria-hidden' => 'true' }
  .modal-dialog{ role: 'document' }
    .modal-content
      %form#new-task-form.task-modal-form{ 'data-error-required' => t('calendars.task_modal.error_required'), 'data-error-save' => t('calendars.task_modal.error_save') }
        .modal-header
          %button.btn-close{ type: 'button', 'data-bs-dismiss' => 'modal', 'aria-label' => t('calendars.task_modal.close') }
          %h4#taskModalLabel.modal-title= t('calendars.task_modal.title')
          %p.text-muted.task-modal-subtitle= t('calendars.task_modal.subtitle')
        .modal-body
          .alert.alert-danger.task-modal-error.d-none{ role: 'alert', 'aria-live' => 'assertive' }
          .mb-3
            %label.form-label{ for: 'task-client' }= t('calendars.task_modal.person')
            %select#task-client.form-select{ 'aria-required' => 'true' }
              %option{ value: '' }= t('calendars.task_modal.select_person')
              - people = Client.accessible_by(current_ability).joins(:client_enrollments).where(client_enrollments: { status: 'Active' }).distinct
              - people.sort_by { |c| c.name.to_s.downcase }.each do |client|
                %option{ value: client.id }= client.name
          .mb-3
            %label.form-label{ for: 'task-program' }= t('calendars.task_modal.program')
            %select#task-program.form-select{ disabled: true, 'data-placeholder-empty' => t('calendars.task_modal.select_person_first', default: 'Choose a person first'), 'data-placeholder-loading' => t('calendars.task_modal.loading'), 'data-placeholder-select' => t('calendars.task_modal.select_program'), 'data-placeholder-none' => t('calendars.task_modal.no_programs', default: 'No active programs for this person'), 'data-placeholder-error' => t('calendars.task_modal.load_error') }
              %option{ value: '' }= t('calendars.task_modal.select_person_first', default: 'Choose a person first')
          .mb-3
            %label.form-label{ for: 'task-domain' }= t('calendars.task_modal.domain')
            %select#task-domain.form-select{ 'aria-required' => 'true' }
              %option{ value: '' }= t('calendars.task_modal.select_domain')
              - Domain.all.each do |domain|
                %option{ value: domain.id }= "#{domain.name} #{domain.identity}".strip
          .mb-3
            %label.form-label{ for: 'task-name' }= t('calendars.task_modal.task_name')
            %input#task-name.form-control{ type: 'text', 'aria-required' => 'true', placeholder: t('calendars.task_modal.task_name_placeholder'), maxlength: '255' }
          .mb-3
            %label.form-label{ for: 'task-completion-date' }= t('calendars.task_modal.completion_date')
            .input-group.date
              %input#task-completion-date.form-control.date-picker{ type: 'text', 'aria-required' => 'true' }
              %span.input-group-text
                %i.fa.fa-calendar-check-o
          -# Data-task batch (2026-07): optional time-of-day scheduling — native inputs,
          -# CSP-safe, zero JS. Blank start time = an all-day task (today's behavior).
          .row
            .col-6.mb-3
              %label.form-label{ for: 'task-start-time' }= t('calendars.task_modal.start_time', default: 'Start time (optional)')
              %input#task-start-time.form-control{ type: 'time', step: 900 }
            .col-6.mb-3
              %label.form-label{ for: 'task-duration' }= t('calendars.task_modal.duration', default: 'Duration')
              %select#task-duration.form-select
                %option{ value: '' }= t('calendars.task_modal.duration_all_day', default: 'All day')
                - [15, 30, 45, 60, 90, 120, 180, 240].each do |minutes|
                  %option{ value: minutes }= t('calendars.task_modal.duration_minutes', default: '%{count} min', count: minutes)
        .modal-footer
          %button.btn.btn-outline-secondary{ type: 'button', 'data-bs-dismiss' => 'modal' }= t('calendars.task_modal.cancel')
          %button#task-submit.btn.btn-primary{ type: 'submit', 'data-label-create' => t('calendars.task_modal.create'), 'data-label-creating' => t('calendars.task_modal.creating') }= t('calendars.task_modal.create')
