.row
  .col-12
    = simple_form_for [@case_note.client, @case_note], {input_html: {id: 'case-note-form'}} do |f|
      .ibox
        .ibox-title
          %h5= t('.meeting_detail')
        .ibox-content
          / .well.b-r-lg.bg-color
          /   %strong= "#{t('.label_note')}: "
          /   %strong= @case_note.client.name
          /   %span= t('.meeting_with')
          /   %strong= current_user.first_name
          .card
            .card-body
              .mb-3.date.optional.case_note_meeting_date{ class: ('has-error' if f.error :meeting_date) }
                %label.date.optional.form-label
                  %abbr{ title: 'required' } *
                  = t('.on_date')
                .input-group.date
                  = f.text_field :meeting_date, class: 'date optional form-control date-picker', type: 'text', name: 'case_note[meeting_date]', id: 'case_note_meeting_date'
                  %span.input-group-text
                    %i.fa.fa-calendar-check-o
                = f.error :meeting_date
              .row
                .col-12
                  #meeting-date-message.text-danger
              = f.input :attendee, label: t('.present')
              .row
                .col-12
                  #attendee-message.text-danger
          -# UX round 3 (D1/R7): staff pick the domains the session covered — only those
          -# sections show (JS hides + DISABLES the rest, so nothing from them submits; the
          -# model reject_if is the no-JS/defense-in-depth path). Sections with existing
          -# content are pre-selected on edit / validation re-render.
          .mb-3.case-note-domain-picker
            %label.form-label{ for: 'case-note-domain-select' }= t('.domains_discussed', default: 'Domains discussed')
            %select#case-note-domain-select{ multiple: true, 'aria-describedby' => 'case-note-domain-hint' }
              - @case_note.case_note_domain_groups.each do |cndg|
                %option{ value: cndg.domain_group_id, selected: case_note_section_selected?(cndg) }
                  = "#{cndg.domain_group.name} (#{cndg.domain_group.domain_identities})"
            %small#case-note-domain-hint.text-muted= t('.domains_discussed_hint', default: 'Only the selected domains appear below and are saved.')
          = f.simple_fields_for :case_note_domain_groups do |cd|
            - if cd.object.domain_group.domains.assessment_domains_by_assessment_id(@case_note.assessment_id).any?
              = render 'form_with_assessment_domains', { cd: cd }
            - else
              = render 'form_without_assessment_domains', { cd: cd }

        .ibox-footer
          = f.submit t('.save'), class: 'btn btn-primary btn-form', id: 'case-note-submit-btn'
          = link_to t('.back') , client_case_notes_path(@case_note.client), class: 'btn btn-outline-secondary btn-form'

    = render 'add_task_form'
