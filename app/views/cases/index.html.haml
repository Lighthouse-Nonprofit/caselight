.row
  .col-12
    .ibox
      .ibox-title
        -# (Pre-production polish: the raw case_type code — "KC" etc. — is internal; don't render it.)
        %h5= t('.history')
        .ibox-tools
          = link_to client_path(@client) do
            .btn.btn-outline.btn-outline-secondary.button
              = t('.back')
      .ibox-content
        .row
          - @cases.each do |case_history|
            .col-12.col-md-6
              .ibox.border-left-right.border-bottom
                .ibox-title
                  %h5= t('.exit_date')
                  %span.badge.text-bg-info
                    = case_history.exit_date.strftime('%B %d, %Y')
                  .ibox-tools
                    - if can? :manage, Case
                      - if current_user.admin? || current_user.manager?
                        %small
                          = link_to edit_client_case_path(case_history.client, case_history) do
                            .btn.btn-outline.btn-success
                              = fa_icon('pencil')
                .ibox-content
                  -# UX round 4 (R4-4): per-history bordered table -> the info grid
                  -# (the .border-right label-cell variant dies with it).
                  - items = []
                  - items << info_item(t('.exit_note'), case_history.exit_note)
                  - items << info_item(t('.start_date'), (case_history.start_date.strftime('%B %d, %Y') if case_history.start_date))
                  -# Carer rows are resettlement-only (OCA feedback 2026-08-26).
                  - youth_flavor = Rails.application.config.x.flavor == 'youth'
                  - unless youth_flavor
                    - items << info_item(t('.carer_names'), case_history.carer_names)
                    - items << info_item(t('.carer_address'), case_history.carer_address)
                  - items << info_item(t('.province'), (case_history.province.name if case_history.province))
                  - unless youth_flavor
                    - items << info_item(t('.carer_phone_number'), (case_history.carer_phone_number.phony_formatted(normalize: :KH, format: :international) if case_history.carer_phone_number))
                  - items << info_item(t('.support_amount'), number_to_currency(case_history.support_amount))
                  - items << info_item(t('.support_note'), case_history.support_note)
                  - items << info_item(t('.ongoing_partner'), (partner(case_history.partner) if case_history.partner))
                  - items << info_item(t('.family'), (family(case_history.family) if case_history.family))
                  - items << info_item(t('.family_preservation'), human_boolean(case_history.family_preservation))
                  = render 'shared/info_grid', items: items
