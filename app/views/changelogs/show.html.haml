.row
  .col-12
    .container
      .row
        .col-12
          .card
            .card-header
              %h4
                = @changelog.change_version
                %small= @changelog.created_at.strftime('%d %B, %Y')
            .card-body
              %p= render_rich_text(@changelog.description)
            .card-footer
              = link_to t('.back'), changelogs_path, class: 'btn btn-outline-secondary btn-back'
