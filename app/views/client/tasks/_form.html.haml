= simple_form_for([@task.client, @task], html: { class: 'task-form' }) do |f|
  = error_notification(f)

  = f.association :domain, collection: Domain.all, label_method: ->(domain){"#{domain.name} #{domain.identity}"}, include_blank: false, label: t('.domain')
  = f.input :name, label: t('.enter_task_detail')

  .mb-3.date.required.task_completion_date{ class: ('has-error' if f.error :completion_date) }
    %label.date.required.form-label{ for: 'task_completion_date' }
      %abbr{ title: 'required' } *
      = t('.completion_date')
    .input-group.date
      = f.text_field :completion_date, class: 'date required form-control date-picker', type: 'text', name: 'task[completion_date]', id: 'task_completion_date'
      %span.input-group-text
        %i.fa.fa-calendar-check-o
    = f.error :completion_date

  -# Data-task batch (2026-07): optional time-of-day — blank = all-day (native inputs, no JS).
  .row
    .col-12.col-md-6.mb-3
      %label.form-label{ for: 'task_start_time' }= t('.start_time', default: 'Start time (optional)')
      = f.text_field :start_time, type: 'time', step: 900, class: 'form-control', id: 'task_start_time', value: (@task.start_time&.strftime('%H:%M'))
    .col-12.col-md-6.mb-3
      %label.form-label{ for: 'task_duration_minutes' }= t('.duration', default: 'Duration')
      = f.select :duration_minutes, options_for_select([[t('.duration_all_day', default: 'All day'), '']] + [15, 30, 45, 60, 90, 120, 180, 240].map { |m| ["#{m} min", m] }, @task.duration_minutes), {}, class: 'form-select', id: 'task_duration_minutes'

  = f.submit t('.save'), class: 'btn btn-primary form-btn'
  = link_to t('.back'), client_tasks_path(@task.client), class: 'btn btn-outline-secondary form-btn'
