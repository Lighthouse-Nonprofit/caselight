.row
  .col-12.col-md-10.offset-md-1
    = render 'clients/client_header', client: @client, active_tab: client_hub_active_tab
    .ibox
      .ibox-title
        %h5= t('client.tasks.index.tasks', default: 'Tasks')
        .ibox-tools
          - if can? :manage, Task
            = link_to new_client_task_path(@client) do
              .btn.btn-primary.btn-width
                = t('.new_task')
      .ibox-content
        .card
          .card-header
            .row
              .col-6
                = t('.overdue_tasks')
          .card-body
            .row
              .col-12
                %table.table.table-bordered
                  - @tasks.incomplete.overdue.each do |task|
                    %tr
                      %td= "#{t('.domain')}: #{task.domain.name}"
                      %td.task-name= task.name
                      %td= task.completion_date.strftime("%B %d, %Y")
                      - if can? :manage, Task
                        %td.text-center.margin-icon
                          = link_to edit_client_task_path(@client, task) do
                            .btn.btn-outline.btn-success.btn-xs
                              %i.fa.fa-pencil
                          = link_to client_task_path(@client, task), method: :delete, data: { confirm: t('.are_you_sure_you_want_to_delete') } do
                            .btn.btn-outline.btn-danger.btn-xs
                              %i.fa.fa-trash

        .card
          .card-header
            .row
              .col-6
                = t('.today_tasks')
          .card-body
            .row
              .col-12
                %table.table.table-bordered
                  - @tasks.incomplete.today.each do |task|
                    %tr
                      %td= "#{t('.domain')}: #{task.domain.name}"
                      %td= task.name
                      %td= task.completion_date.strftime("%B %d, %Y")
                      - if can? :manage, Task
                        %td.text-center.margin-icon
                          = link_to edit_client_task_path(@client, task) do
                            .btn.btn-outline.btn-success.btn-xs
                              %i.fa.fa-pencil
                          = link_to client_task_path(@client, task), method: :delete, data: { confirm: t('.are_you_sure_you_want_to_delete') } do
                            .btn.btn-outline.btn-danger.btn-xs
                              %i.fa.fa-trash
        .card
          .card-header
            .row
              .col-6
                = t('.upcoming_tasks')
          .card-body
            .row
              .col-12
                %table.table.table-bordered
                  - @tasks.incomplete.upcoming.each do |task|
                    %tr
                      %td= "#{ t('.domain') }: #{task.domain.name}"
                      %td= task.name
                      %td= task.completion_date.strftime("%B %d, %Y")
                      - if can? :manage, Task
                        %td.text-center.margin-icon
                          = link_to edit_client_task_path(@client, task) do
                            .btn.btn-outline.btn-success.btn-xs
                              %i.fa.fa-pencil
                          = link_to client_task_path(@client, task), method: :delete, data: { confirm: t('.are_you_sure_you_want_to_delete') } do
                            .btn.btn-outline.btn-danger.btn-xs
                              %i.fa.fa-trash
