.row
  .col-12.col-md-10.offset-md-1
    = render 'clients/client_header', client: @client, active_tab: client_hub_active_tab
    .ibox
      .ibox-title
        %h5= t('client.tasks.index.tasks', default: 'Tasks')
        .ibox-tools
          - if can? :manage, Task
            = link_to new_client_task_path(@client) do
              .btn.btn-primary.btn-width
                = t('.new_task')
      .ibox-content
        -# Demo UX polish — the task NAME opens the detail modal (edit/delete/complete live there);
        -# the row keeps a one-click Complete so a task can be closed from the list without a trip in.
        - [[t('.overdue_tasks'), @tasks.incomplete.overdue], [t('.today_tasks'), @tasks.incomplete.today], [t('.upcoming_tasks'), @tasks.incomplete.upcoming]].each do |label, tasks|
          - if tasks.any?
            .card
              .card-header
                .row
                  .col-6= label
              .card-body
                .row
                  .col-12
                    %table.table.table-bordered.table-hover
                      - tasks.each do |task|
                        %tr
                          - if can? :manage, Task
                            %td.text-center{ style: 'width: 3rem' }
                              = link_to complete_client_task_path(@client, task), method: :patch, class: 'btn btn-outline-primary btn-xs', title: t('.mark_complete', default: 'Mark complete'), 'aria-label': t('.mark_complete', default: 'Mark complete') do
                                %i.fa.fa-check
                          %td= "#{t('.domain')}: #{task.domain.name}"
                          %td.task-name
                            %button.btn.btn-link.p-0.text-start.text-decoration-none{ type: 'button', 'data-bs-toggle': 'modal', 'data-bs-target': "#taskModal-#{task.id}" }= task.name
                          %td= task.completion_date.strftime("%B %d, %Y")
                          %td= task.users.map(&:name).join(', ')
        - if @tasks.completed.any?
          .card
            .card-header
              .row
                .col-6= t('.completed_tasks', default: 'Completed')
            .card-body
              .row
                .col-12
                  %table.table.table-bordered.table-hover
                    - @tasks.completed.each do |task|
                      %tr
                        - if can? :manage, Task
                          %td.text-center{ style: 'width: 3rem' }
                            = link_to complete_client_task_path(@client, task), method: :patch, class: 'btn btn-outline-secondary btn-xs', title: t('.reopen', default: 'Reopen') do
                              %i.fa.fa-undo
                        %td= "#{t('.domain')}: #{task.domain.name}"
                        %td.task-name.text-decoration-line-through
                          %button.btn.btn-link.p-0.text-start.text-decoration-none{ type: 'button', 'data-bs-toggle': 'modal', 'data-bs-target': "#taskModal-#{task.id}" }= task.name
                        %td= task.completion_date.strftime("%B %d, %Y")
                        %td= task.users.map(&:name).join(', ')
        -# task detail modals (one per task) — rendered outside the tables
        - @tasks.each do |task|
          = render 'tasks/task_modal', task: task
