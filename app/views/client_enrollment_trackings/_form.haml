= simple_form_for([@client, @enrollment, @client_enrollment_tracking], html: { class: 'client-enrollment-tracking' }) do |f|
  .ibox-content
    %h3= "#{@client.en_and_local_name} - #{@tracking.name} - #{@program_stream.name}"
    -# Y2(a): the SERVICE date — a real column, backdatable (late data entry, session
    -# logs after the fact). Defaults to today; NOT part of the properties JSON.
    .row
      .col-12.col-md-6.mb-3
        %label.form-label{ for: 'client_enrollment_tracking_entry_date' }= t('.entry_date', default: 'Date of service / session')
        = f.text_field :entry_date, type: 'date', class: 'form-control', id: 'client_enrollment_tracking_entry_date', value: (@client_enrollment_tracking.entry_date || Time.zone.today).iso8601
    = f.simple_fields_for :properties, OpenStruct.new(@client_enrollment_tracking.properties) do |prop_f|
      - @tracking.fields.each_slice(2) do |n_field|
        .row
          - n_field.each do |field|
            .col-12.col-md-6
              - unless field['type'] == 'file'
                = render "/shared/fields/#{field['type'].underscore}", f: prop_f, field_props: field, errors: @client_enrollment_tracking.errors.messages, entity: f
              - else
                = f.simple_fields_for :form_builder_attachments, @attachments.file_by_name(field['label']) || @attachments.build do |attachment|
                  = render 'shared/form_builder/attachment', f: attachment, property: field, entity: f, resource: @client_enrollment_tracking
        .row
          .col-12
            #message.text-danger
  .ibox-footer
    = hidden_field_tag :tracking_id, @tracking.id
    = f.submit t('.save'), class: 'btn btn-primary form-btn'
    = link_to t('.cancel'), client_client_enrollments_path(@client, program_stream_id: @program_stream.id), class: 'btn btn-outline-secondary form-btn'
    -# Investor UX round (2026-07): delete lives on the EDIT page now (the list rows lost
    -# their trash icons) — destructive control last/outermost per docs/ui-conventions.md.
    - if @client_enrollment_tracking.persisted? && (can? :destroy, @client_enrollment_tracking)
      = link_to client_client_enrollment_client_enrollment_tracking_path(@client, @enrollment, @client_enrollment_tracking), method: 'delete', data: { confirm: t('client_enrollment_trackings.form.are_you_sure', default: 'Are you sure you want to delete?') }, class: 'btn btn-outline-danger form-btn action-gap-start' do
        = t('.delete', default: 'Delete')
