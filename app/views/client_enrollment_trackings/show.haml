.row
  .col-12
    = link_to client_client_enrollment_client_enrollment_trackings_path(@client, @enrollment) do
      .btn.btn-primary.btn-outline.float-end
        = t('.trackings_list')
.row
  .col-12
    .ibox
      .ibox-title
        %h5= "#{@client.en_and_local_name} - #{@client_enrollment_tracking.tracking.try(:name)} - #{@program_stream.name}"
        .ibox-tools
          - if (can? :manage, ClientEnrollmentTracking) && (policy(@client_enrollment_tracking).update?)
            = link_to edit_client_client_enrollment_client_enrollment_tracking_path(@client, @enrollment, @client_enrollment_tracking, tracking_id: @client_enrollment_tracking.tracking) do
              .btn.btn-success.btn-outline
                = fa_icon('pencil')
          = link_to report_client_client_enrollments_path(@client, program_stream_id: @program_stream) do
            .btn.btn-outline-secondary.btn-back-default
              = t('.back')
      .ibox-content
        -# UX round 4 (R4-4): field table -> the info grid (user-authored labels = natural case).
        = render 'shared/info_grid', items: custom_field_info_items(@client_enrollment_tracking.tracking.fields, @client_enrollment_tracking), variant: 'info-grid--natural-case'
