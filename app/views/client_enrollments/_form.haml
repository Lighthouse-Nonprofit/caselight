= simple_form_for([@client, @client_enrollment], html: { class: 'client-enrollment' }) do |f|
  .ibox-content
    .row
      .col-12.col-md-6.mb-3.date.optional{ class: ('has-error' if f.error :enrollment_date) }
        %label.date.optional.form-label
          %abbr{ title: 'required' } *
          = t('.enrollment_date')
        .input-group.date
          = f.input_field :enrollment_date, as: :string, class: 'date optional form-control date-picker', id: 'enrollment_date'
          %span.input-group-text
            %i.fa.fa-calendar-check-o
        - if f.error :enrollment_date
          %span.form-text= t('cannot_be_blank')
    = f.simple_fields_for :properties, OpenStruct.new(@client_enrollment.properties) do |prop_f|
      - @program_stream.enrollment.each_slice(2) do |n_field|
        .row
          - n_field.each do |enrollment|
            .col-12.col-md-6
              - unless enrollment['type'] == 'file'
                = render "/shared/fields/#{enrollment['type'].underscore}", f: prop_f, field_props: enrollment, errors: @client_enrollment.errors.messages, entity: f
              - else
                = f.simple_fields_for :form_builder_attachments, @attachments.file_by_name(enrollment['label']) ||  @attachments.build do |attachment|
                  = render 'shared/form_builder/attachment', f: attachment, property: enrollment, entity: f, resource: @client_enrollment
          .row
            .col-12
              #message.text-danger
  .ibox-footer
    = hidden_field_tag :program_stream_id, @program_stream.id
    = f.submit t('.save'), class: 'btn btn-primary form-btn'
    = cancel_url
    -# Investor UX round (2026-07): delete lives HERE (edit only) — it cascades the program's
    -# trackings + exit record, so it sits behind the edit step, destructive-last per
    -# docs/ui-conventions.md.
    - if @client_enrollment.persisted? && (can? :destroy, @client_enrollment)
      = link_to client_client_enrollment_path(@client, @client_enrollment, program_stream_id: @program_stream), method: 'delete', data: { confirm: t('client_enrollments.show.are_you_sure', default: 'Are you sure you want to delete?') }, class: 'btn btn-outline-danger form-btn action-gap-start' do
        = t('.delete', default: 'Delete')
