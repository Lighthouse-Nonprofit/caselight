= render 'clients/client_header', client: @client, active_tab: client_hub_active_tab
-# Investor UX round (2026-07) — the consolidated Programs tab: one BS5 sub-tab per
-# ever-enrolled program (active panes first, then exited), each pane carrying the program's
-# dates, actions, and report timeline; the old two-table page (Enrolled Programs + the full
-# enrollable "Programs List") is gone. Never-enrolled programs live in the Add Program modal;
-# exited programs re-enroll from their own pane. Server renders the active pane from
-# ?program_stream_id= (the Overview deep-link contract) — no custom JS, BS5 data-bs-toggle
-# handles the switching (precedent: program_streams/index.haml).
.row
  .col-12
    .ibox
      .ibox-title
        %h5= t('.title', default: 'Programs')
        .ibox-tools
          - if (can? :manage, ClientEnrollment) && @enrollable_streams.any?
            %button.btn.btn-primary.btn-xs{ type: 'button', 'data-bs-toggle' => 'modal', 'data-bs-target' => '#add-program-modal' }
              = t('.add_program', default: 'Add Program')
      .ibox-content
        - if @pane_streams.any?
          %ul.nav.nav-tabs.programs-tabs{ role: 'tablist' }
            - @pane_streams.each do |ps|
              %li.nav-item{ role: 'presentation' }
                %button.nav-link{ class: ('active' if ps.id == @selected_stream_id), id: "program-tab-#{ps.id}", type: 'button', role: 'tab', 'data-bs-toggle' => 'tab', 'data-bs-target' => "#program-pane-#{ps.id}", 'aria-controls' => "program-pane-#{ps.id}", 'aria-selected' => (ps.id == @selected_stream_id).to_s }
                  %span.programs-tabs__name= ps.name
                  - if (status = ps.enrollment_status_value(@client))
                    = cl_badge(status, ps.enrollment_status_variant(@client))
          .tab-content.programs-tab-content
            - @pane_streams.each do |ps|
              .tab-pane.fade{ id: "program-pane-#{ps.id}", class: ('show active' if ps.id == @selected_stream_id), role: 'tabpanel', 'aria-labelledby' => "program-tab-#{ps.id}" }
                = render 'program_pane', program_stream: ps, enrollments: (@enrollments_by_stream[ps.id] || [])
        - else
          %p.text-muted= t('.no_programs', default: 'Not yet enrolled in a program.')
- if (can? :manage, ClientEnrollment) && @enrollable_streams.any?
  = render 'add_program_modal'
