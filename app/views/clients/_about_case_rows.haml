-# UX round 3 (A2) — the Resettlement Case facts, folded into the About Individual table as
-# plain rows (the standalone case card is gone). Only the facts the About table did NOT
-# already carry: case type/state, intake date, the CASE household (can differ from the
-# non-case families row), and the exit date for a closed case. Case Manager and Status stay
-# in their canonical spots (About's case-worker row / the hub header badge). Edit/Exit live
-# in the header Actions dropdown.
-# locals: client:
- current_case = client.cases.exclude_referred.current
- if current_case.present?
  %tr
    %td.spacing-first-col= t('clients.show.resettlement_case', default: 'Resettlement case')
    %td
      %strong= t('clients.show.case_active', default: 'Active')
  %tr
    %td.spacing-first-col= t('clients.show.intake_date', default: 'Intake date')
    %td
      %strong= date_format(current_case.start_date) if current_case.start_date
  - if current_case.family.present?
    %tr
      %td.spacing-first-col= t('clients.show.case_household', default: 'Case household')
      %td
        %strong
          - if can? :read, Family
            = link_to family(current_case.family), family_path(current_case.family)
          - else
            = family(current_case.family)
- elsif (last_case = client.cases.exclude_referred.inactive.order(:exit_date).last).present?
  %tr
    %td.spacing-first-col= t('clients.show.resettlement_case', default: 'Resettlement case')
    %td
      %strong= t('clients.show.case_exited', default: 'Closed')
  - if last_case.exit_date.present?
    %tr
      %td.spacing-first-col= t('clients.show.case_exit_date', default: 'Case closed on')
      %td
        %strong= date_format(last_case.exit_date)
