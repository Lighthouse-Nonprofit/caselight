- initials = [object.given_name, object.family_name].map { |p| p.to_s.strip.first }.compact.join.upcase.presence || '?'
- can_read_program = can?(:read, ProgramStream)
- streams  = object.client_enrollments.map(&:program_stream).compact.uniq
- shown    = streams.first(4)
- extra    = streams.size - shown.size
%li.record-card-item
  %article.record-card{ class: ('record-card--muted' if object.status.to_s.start_with?('Exited')), 'aria-labelledby' => "client-card-#{object.id}-name" }
    .record-card__body
      .record-card__avatar{ 'aria-hidden' => 'true' }= initials
      .record-card__ident
        %h3.record-card__name{ id: "client-card-#{object.id}-name" }
          -# The whole card is the click target (BS5 stretched-link); program chips stay
          -# independently clickable via the z-index guard on .record-card__tags.
          = link_to object.name.presence || t('.unknown', default: 'Unknown'), client_path(object), class: 'record-card__name-link stretched-link'
        -# Investor UX round (2026-07): code + slug left the card — record numbers are noise to
        -# case teams (still searchable; admin grid/XLS keep them).
        %p.record-card__meta
          - if object.gender.present?
            %span.record-card__gender= object.gender.try(:titleize)
      - if shown.any?
        %ul.record-card__tags{ 'aria-label' => t('.program_streams', default: 'Programs') }
          - shown.each do |program_stream|
            %li.record-card__tag
              - if can_read_program
                = link_to program_stream.name, program_stream_path(program_stream), class: 'record-card__tag-link'
              - else
                = program_stream.name
          - if extra > 0
            %li.record-card__tag.record-card__tag--more{ title: streams.map(&:name).join(', ') }= "+#{extra}"
