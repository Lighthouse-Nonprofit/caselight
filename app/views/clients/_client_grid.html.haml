-# Limited grid for admin? / strategic_overviewer? on clients#index.
.record-grid
  %table.record-grid__table{ role: 'table' }
    %caption.sr-only= t('.grid_caption', default: 'Individuals')
    %thead
      %tr
        %th{ scope: 'col' }= t('datagrid.columns.clients.name', default: 'Name')
        %th{ scope: 'col' }= t('datagrid.columns.clients.id', default: 'ID')
        %th{ scope: 'col' }= t('datagrid.columns.clients.gender_age', default: 'Gender / Age')
        %th{ scope: 'col' }= t('datagrid.columns.clients.status', default: 'Status')
        %th{ scope: 'col' }= t('datagrid.columns.clients.program_streams', default: 'Programs')
        %th.record-grid__actions-col{ scope: 'col' }
          %span.sr-only= t('datagrid.columns.clients.manage', default: 'Actions')
    %tbody
      - clients.each do |object|
        - streams = object.client_enrollments.map { |ce| ce.program_stream.name if ce.program_stream }.compact.uniq
        - shown   = streams.first(4)
        - extra   = streams.size - shown.size
        - age_str = (pluralize(object.age_as_years, 'yr') + ' ' + pluralize(object.age_extra_months, 'mo') if object.date_of_birth.present?)
        %tr.record-grid__row
          %th.record-grid__name{ scope: 'row' }
            = link_to object.name.presence || t('.unknown', default: 'Unknown'), client_path(object), class: 'record-grid__name-link'
          %td.record-grid__id
            - if object.slug.present?
              %span.record-grid__slug= "##{object.slug}"
          %td.record-grid__demo
            - if object.gender.present?
              %span.record-grid__gender= object.gender.try(:titleize)
            - if object.gender.present? && age_str.present?
              %span.record-grid__sep{ 'aria-hidden' => 'true' } ·
            - if age_str.present?
              %span.record-grid__age= age_str
          %td.record-grid__status
            = status_style(object.status.to_s.sub(/\AActive .*/, 'Active'))
          %td.record-grid__programs
            - if shown.any?
              %ul.record-grid__tags{ 'aria-label' => t('datagrid.columns.clients.program_streams', default: 'Programs') }
                - shown.each do |name|
                  %li.record-grid__tag= name
                - if extra > 0
                  %li.record-grid__tag.record-grid__tag--more{ title: streams.join(', ') }= "+#{extra}"
            - else
              %span.record-grid__empty{ 'aria-hidden' => 'true' } —
          %td.record-grid__actions.text-center
            = link_to client_path(object), class: 'btn btn-xs btn-info btn-outline', 'aria-label' => (t('shared.actions.view', default: 'View') + ' ' + (object.name.presence || object.slug.to_s)) do
              = fa_icon('eye', 'aria-hidden': true)
            = render partial: 'clients/actions', locals: { object: object }
