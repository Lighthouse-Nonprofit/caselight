-# UX rung 4 — persistent client hub header, rendered atop clients#show and every client
-# partition page, so the partitions keep the client's identity + one-click tab navigation.
-# CSP-safe (BS5 data-bs-* only).
-#
-# The status badge here is the ONLY status display outside the search filters (owner call).
-# The tab bar renders only for accepted clients (pre-existing gating on the old button strip).
-# UX round 3 (A3): ONE Actions dropdown, identical on every hub page — every tab's create
-# action lives here, and the exit modals render at the tail of this partial (they used to
-# live on show only, which is why the case items were once show-gated via full_actions).
-#
-# locals: client:, active_tab: (symbol from client_hub_active_tab)
- active_tab   = local_assigns[:active_tab]
-# ClientsController decorates @client (care_code / date_of_birth_format live on
-# ClientDecorator); the partition controllers hand us the bare model — normalize here.
- client = client.decorate unless client.is_a?(Draper::Decorator)
.client-hub
  .client-hub__identity
    .client-hub__who
      %h1.client-hub__name= client.name.presence || t('clients.index.unknown', default: 'Unknown')
      - if client.status.present?
        %span.client-hub__status= status_style(client.status.to_s.sub(/\AActive .*/, 'Active'))
      - if (first_grant = client_hub_active_grants(client).first)
        %span.client-hub__grant.badge.text-bg-warning{ title: t('clients.client_header.grant_title', default: 'Break-glass emergency access active on this record') }
          %i.fa.fa-unlock-alt{ 'aria-hidden' => 'true' }
          = t('clients.client_header.grant_expires', default: 'Emergency access · %{minutes} min left', minutes: [((first_grant.expires_at - Time.current) / 60).ceil, 0].max)
      -# UX round 3 (B3): "read first" household alerts follow the members.
      - if (can? :read, FamilyAlert) && (household_alert = client_hub_household_alerts(client).first)
        = link_to family_family_alerts_path(household_alert.family), class: 'badge text-bg-danger client-hub__household-alert', title: t('clients.client_header.household_alert_title', default: '%{count} active household alert(s)', count: client_hub_household_alerts(client).size) do
          %i.fa.fa-exclamation-triangle{ 'aria-hidden' => 'true' }
          = t('clients.client_header.household_alert', default: 'Household alert')
      -# Investor UX round (2026-07): record numbers (slug + code) and the geographic State left
      -# the display — case teams think in names. The values stay searchable and on the edit form.
      - meta_items = []
      - meta_items << content_tag(:span, client.gender_label) if client.gender.present?
      - meta_items << content_tag(:span, "#{t('clients.show.date_of_birth', default: 'DOB')} #{client.date_of_birth_format} (#{client.age})") if client.date_of_birth.present?
      - client.families.as_non_cases.uniq.each do |fam|
        - meta_items << (can?(:read, Family) ? link_to(family(fam), family_path(fam), class: 'client-hub__family-link') : content_tag(:span, family(fam)))
      %p.client-hub__meta
        = safe_join(meta_items, content_tag(:span, ' · ', class: 'client-hub__sep', 'aria-hidden' => 'true'))
    .client-hub__actions
      -# UX review 1: ONE actions dropdown — edit, case open/close, notes, history, delete
      -# (the separate "Open Resettlement Case" button folded in here).
      - if (can? :manage, Client) || (can? :rud, Client)
        .dropdown.client-hub__edit
          %button.btn.btn-outline-primary.dropdown-toggle{ 'data-bs-toggle' => 'dropdown', 'aria-expanded' => 'false', type: 'button' }
            = t('clients.client_header.actions', default: 'Actions')
          %ul.dropdown-menu.dropdown-menu-end
            %li= link_to t('shared.actions.edit', default: 'Edit'), edit_client_path(client), class: 'dropdown-item'
            - if client.state == 'accepted'
              - if can? :manage, Case
                %li
                  %hr.dropdown-divider
                - if client.cases.exclude_referred.current.blank?
                  -# Pre-production polish (2026-07-31): ONE case action. The three upstream
                  -# care-placement buttons (Priority Intake / Sponsor Care / Kinship Care)
                  -# collapse to the household case (KC = the active-household type here);
                  -# label = "Add to Household" — opening the case IS the household link.
                  %li= client.kc_button
                  %li
                    - if client.client_enrollments.active.count > 0
                      %a{ 'data-bs-target' => '#remaining-programs-modal', 'data-bs-toggle' => 'modal' }
                        .text-warning= t('clients.show.exit_ngo_btn')
                    - else
                      %a{ 'data-bs-target' => '#exitFromNgo', 'data-bs-toggle' => 'modal' }
                        .text-warning= t('clients.show.exit_ngo_btn')
                - if (current_case = client.cases.exclude_referred.current).present?
                  -# UX round 3 (A2): the case card's Edit button moved here with the fold-in.
                  -# Instance-level can? reproduces the per-type manager gating (EC/FC/KC rules).
                  - if can? :update, current_case
                    %li= link_to t('clients.client_header.edit_case', default: 'Edit Case'), edit_client_case_path(client, current_case), class: 'dropdown-item'
                  %li
                    %a{ 'data-bs-target' => '#exit-from-case', 'data-bs-toggle' => 'modal' }
                      .text-warning.exit-case-warning= t("clients.show.exit_from_#{current_case.case_type.downcase}")
                %li
                  %hr.dropdown-divider
              - if can? :create, CaseNote
                %li= link_to t('clients.client_header.new_case_note', default: 'New Case Note'), new_client_case_note_path(client), class: 'dropdown-item'
              -# UX round 3 (A3): every tab's create action lives here too.
              - if can? :manage, CustomFieldProperty
                %li= link_to t('clients.client_header.add_form', default: 'Add Form'), client_forms_path(client), class: 'dropdown-item'
              - if can? :manage, Assessment
                - if client.can_create_assessment?
                  %li= link_to t('clients.client_header.new_assessment', default: 'New Assessment'), new_client_assessment_path(client), class: 'dropdown-item'
                - else
                  -# (mirrors assessments/index: creation waits out the 6-month window)
                  %li
                    %span.dropdown-item.disabled{ 'aria-disabled' => 'true', title: t('clients.client_header.next_assessment_hint', default: 'Next assessment available %{date}', date: date_format(client.next_assessment_date)) }
                      = t('clients.client_header.new_assessment', default: 'New Assessment')
              - if can? :manage, Task
                %li= link_to t('clients.client_header.new_task', default: 'New Task'), new_client_task_path(client), class: 'dropdown-item'
              - if (can? :create, FamilyAlert) && client.families.any?
                %li= link_to t('clients.client_header.new_household_alert', default: 'New Household Alert'), new_family_family_alert_path(client.families.first), class: 'dropdown-item'
              - if can? :manage, Referral
                %li= link_to t('clients.client_header.new_referral', default: 'New Referral (out)'), new_client_referral_path(client), class: 'dropdown-item'
              - if can_read_client_progress_note?(client)
                %li= link_to t('clients.show.progress_note'), client_progress_notes_path(client), class: 'dropdown-item'
              - if client.has_any_quarterly_reports? && (can? :manage, QuarterlyReport)
                %li= link_to t('clients.show.view_legacy_quarterly_reports'), client_case_quarterly_reports_path(client, client.latest_case), class: 'dropdown-item'
              - if client.cases.exclude_referred.inactive.present?
                - if client.cases.exclude_referred.emergencies.inactive.present? && (ec_manageable || strategic_overviewer?)
                  %li= link_to t('clients.show.view_ec_history_btn_link'), client_cases_path(client, case_type: 'EC'), class: 'dropdown-item'
                - if client.cases.exclude_referred.fosters.inactive.present? && (fc_manageable || strategic_overviewer?)
                  %li= link_to t('clients.show.view_fc_history_btn_link'), client_cases_path(client, case_type: 'FC'), class: 'dropdown-item'
                - if client.cases.exclude_referred.kinships.inactive.present? && (kc_manageable || strategic_overviewer?)
                  %li= link_to t('clients.show.view_kc_history_btn_link'), client_cases_path(client, case_type: 'KC'), class: 'dropdown-item'
            %li
              %hr.dropdown-divider
            %li= link_to t('shared.actions.delete', default: 'Delete'), client, method: 'delete', data: { confirm: t('clients.show.are_you_sure') }, class: 'dropdown-item text-danger'
  - if client.state == 'accepted'
    %ul.nav.nav-pills.client-hub__tabs
      %li.nav-item
        = link_to t('clients.client_header.overview', default: 'Overview'), client_path(client), class: "nav-link #{'active' if active_tab == :overview}"
      %li.nav-item
        = link_to client_client_enrollments_path(client), class: "nav-link #{'active' if active_tab == :programs}" do
          = t('clients.client_header.programs', default: 'Programs')
          %span.client-hub__tab-chip= client.client_enrollments.active.count
      -# UX round 3 (A1): Forms is a real partition page (Programs-style; the Overview card and
      -# its anchor are gone). Always rendered — Add Form needs a home even at zero filled forms.
      %li.nav-item
        = link_to client_forms_path(client), class: "nav-link #{'active' if active_tab == :forms}" do
          = t('clients.client_header.forms', default: 'Forms')
          %span.client-hub__tab-chip= client_hub_forms(client).size
      - if can? :manage, CaseNote
        %li.nav-item
          = link_to client_case_notes_path(client), class: "nav-link #{'active' if active_tab == :case_notes}" do
            = t('clients.client_header.case_notes', default: 'Case Notes')
            %span.client-hub__tab-chip= client.case_notes.count
      %li.nav-item
        = link_to client_assessments_path(client), class: "nav-link #{'active' if active_tab == :assessments}" do
          = t('clients.client_header.assessments', default: 'Assessments')
          %span.client-hub__tab-chip= client.assessments.count
      %li.nav-item
        = link_to client_tasks_path(client), class: "nav-link #{'active' if active_tab == :tasks}" do
          = t('clients.client_header.tasks', default: 'Tasks')
          %span.client-hub__tab-chip= client.tasks.incomplete.count
      - if can? :manage, Referral
        %li.nav-item
          = link_to client_referrals_path(client), class: "nav-link #{'active' if active_tab == :referrals}" do
            = t('clients.client_header.referrals', default: 'Referrals')
            %span.client-hub__tab-chip= client.referrals.count
-# UX round 3 (A3): the exit modals the Actions items target — rendered with the header so
-# the dropdown works on every hub page, not just show. Same gates as the menu items above.
- if client.state == 'accepted' && (can? :manage, Case)
  - if client.cases.exclude_referred.current.blank?
    - if client.client_enrollments.active.count > 0
      = render 'clients/remaining_programs', client: client
    - else
      = render 'clients/exit_ngo_form', client: client
  - else
    = render 'clients/exit_case_form', client: client, client_case: client.cases.exclude_referred.current
