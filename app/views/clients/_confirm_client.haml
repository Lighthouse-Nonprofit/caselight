#confirm-client-modal.modal.fade{ 'aria-hidden' => 'true', role: 'dialog' }
  = hidden_field(:hidden, :title, value: t('.title'))
  = hidden_field(:hidden, :body_first, value: t('.body_first') )
  = hidden_field(:hidden, :body_second, value: t('.body_second') )
  = hidden_field(:hidden, :body_third, value: t('.body_third') )
  .modal-dialog
    .modal-content
      .modal-header.card-header
        %button.close{ 'aria-hidden' => 'true', 'data-bs-dismiss' => 'modal', type: 'button' } ×
        %h4.modal-title
      .modal-body.text-center
      .modal-footer
        %button#confirm.btn.btn-warning{ type: 'button' }
          = t('.confirm')
        %button.btn.btn-outline-secondary{ 'data-bs-dismiss' => 'modal', type: 'button' }
          = t('.close')
