.btn-group
  %button.btn.btn-outline-secondary.dropdown-toggle{"aria-expanded" => "false", "aria-haspopup" => "true", "data-bs-toggle" => "dropdown", :type => "button"}
    Fields Visbility

  = form_for @client_grid, url: clients_url, method: 'get' do
    .form-check
      %input.form-check-input{type: 'checkbox', name: 'f_name', id: 'f_name'}
      %label.form-check-label{for: 'f_name'} name
    .form-check
      %input.form-check-input{type: 'checkbox', name: 'f_gender', id: 'f_gender'}
      %label.form-check-label{for: 'f_gender'} gender
    .form-check
      %input.form-check-input{type: 'checkbox', name: 'f_follow_up_date', id: 'f_follow_up_date'}
      %label.form-check-label{for: 'f_follow_up_date'} Follow Up Date
    .form-check
      %input.form-check-input{type: 'checkbox', name: 'f_received_by', id: 'f_received_by'}
      %label.form-check-label{for: 'f_received_by'} Received By
    .form-check
      %input.form-check-input{type: 'checkbox', name: 'f_followed_up_by', id: 'f_followed_up_by'}
      %label.form-check-label{for: 'f_followed_up_by'} Followed Up By
    %button{type: 'submit', class: 'btn btn-outline-secondary'} Done
