= simple_form_for(@client, html: { class: 'client-form' }) do |f|
  = hidden_field(:client, :id, value: @client.id)
  .ibox-content
    = error_notification(f)
    .form-inputs
      .row
        .col-12.col-sm-6.col-md-4= f.input :given_name, label: t('.given_name')
        .col-12.col-sm-6.col-md-4= f.input :family_name, label: t('.family_name')
        .col-12.col-sm-6.col-md-4= f.input :local_given_name, label: t('.local_given_name')
        .col-12.col-sm-6.col-md-4= f.input :local_family_name, label: t('.local_family_name')
        -# D4: CA SOGI list — ONE source (Client::GENDER_OPTIONS + i18n labels)
        .col-12.col-sm-6.col-md-4= f.input :gender, collection: Client::GENDER_OPTIONS.map { |g| [t("clients.gender_options.#{g}", default: g.titleize), g] }, label: t('.gender')
        .col-12.col-sm-6.col-md-4.mb-3.date.optional.client_date_of_birth
          %label.date.optional.form-label{ for: 'client_date_of_birth' }= t('.date_of_birth')
          #client-birthdate.input-group.date
            = f.text_field :date_of_birth, class: 'date optional form-control date-picker', type: 'text', name: 'client[date_of_birth]', id: 'client_date_of_birth'
            %span.input-group-text
              %i.fa.fa-calendar-check-o
        -# Youth flavor: school collapses to the single hub-linked 'School' quantitative (set via the
        -# quantitative editor / Casebook import) — hide the legacy free-text school_name here. Country
        -# of Origin (birth_province) is a resettlement concept — hidden in youth too.
        - youth_flavor = Rails.application.config.x.flavor == 'youth'
        - unless youth_flavor
          .col-12.col-sm-6.col-md-4= f.input :school_name, label: t('.school_name')
        .col-12.col-sm-6.col-md-4= f.input :grade, label: t('.school_grade')
        -# Pre-production polish: provinces = the Countries of Origin list (seeded by
        -# slo4home:seed_countries). The separate "State"/current-province select is
        -# pilot-hidden — current location lives in the address field.
        - unless youth_flavor
          .col-12.col-sm-6.col-md-4= f.input :birth_province_id, collection: @province.map{|p| [p.name, p.id]},  label: t('.province')
        .col-12.col-sm-6.col-md-4
          = f.association :donor, collection: @donors, label: t('.donor')
        - if f.object.current_address.present?
          .col-12.col-sm-6.col-md-4= f.input :current_address, input_html: { rows: '6' }, label: t('.current_address')
        .col-12.col-sm-6.col-md-4= f.association :users, collection: @users, label: t('.case_worker_or_staff'), include_blank: false, multiple: true

        .col-12.col-sm-6.col-md-4= f.input :received_by_id, collection: @users, label: t('.received_by')
        .col-12.col-sm-6.col-md-4= f.input :followed_up_by_id, collection: @users, label: t('.followed_up_by')
        .col-12.col-sm-6.col-md-4.mb-3.date.optional.client_initial_referral_date
          %label.date.optional.form-label{ for: 'client_initial_referral_date' }= t('.initial_referral_date')
          .input-group.date
            = f.text_field :initial_referral_date, class: 'date optional form-control date-picker', type: 'text', name: 'client[initial_referral_date]', id: 'client_initial_referral_date'
            %span.input-group-text
              %i.fa.fa-calendar-check-o

        -# Youth flavor: schools are the 'School' quantitative, not a generic agency — keep them out
        -# of the "Agencies involved" picker so school isn't a third field on the record.
        - agency_collection = youth_flavor ? @agencies.reject { |a| a.kind == 'school' } : @agencies
        .col-12.col-sm-6.col-md-4= f.association :agencies, collection: agency_collection, multiple: true, label_method: :name, value_method: :id, label: t('.agencies_involved')
        .col-12.col-sm-6.col-md-4= f.association :referral_source, collection: @referral_source, label: t('.referral_source')
        .col-12.col-sm-6.col-md-4.mb-3.date.optional.client_follow_up_date
          %label.date.optional.form-label{ for: 'client_follow_up_date' }= t('.follow_up_date')
          .input-group.date
            = f.text_field :follow_up_date, class: 'date optional form-control date-picker', type: 'text', name: 'client[follow_up_date]', id: 'client_follow_up_date'
            %span.input-group-text
              %i.fa.fa-calendar-check-o

        .col-12.col-sm-6.col-md-4
          = f.input :referral_phone, label: t('.referral_phone')
        -# D6: contact email + reminder consent (sends only happen when BOTH are set AND
        -# the installation's SMTP feature flip is on — ClientMessaging.enabled?)
        .col-12.col-sm-6.col-md-4
          = f.input :email, label: t('.email', default: 'Email'), input_html: { type: 'email', autocomplete: 'off' }
        .col-12.col-sm-6.col-md-4
          = f.input :notify_consent, as: :boolean, label: t('.notify_consent', default: 'May we send appointment reminders to this email?')
        .col-12.col-sm-6.col-md-4
          = f.input :live_with, label: t('.live_with')
        - if @client.exit_date_was.present?
          .col-12.col-sm-6.col-md-4.mb-3.date.optional{ class: ('has-error' if f.error :exit_date) }
            %label.date.optional.form-label
              %abbr{ title: 'required' } *
              = t('.exit_date')
            .input-group.date
              = f.text_field :exit_date, class: 'date optional form-control date-picker', type: 'text', name: 'client[exit_date]', id: 'client_exit_date', required: true
              %span.input-group-text
                %i.fa.fa-calendar-check-o
            = f.error :exit_date
          .col-12.col-sm-6.col-md-4
            = f.input :status, collection: Client::EXIT_STATUSES, include_blank: false, label: t('.exit_status')
          .col-12.col-sm-6.col-md-4
            = f.input :exit_note, label: t('.exit_note'), required: true
      .row
        .col-12.col-md-8
          = f.input :relevant_referral_information, input_html: { rows: '5' }, label: t('.relevant_referral_information')

      -# D3: the quantitative editor — the config layer's reference lists finally get a UI.
      -# One select per type (multi when the type allows it); every select posts into the
      -# same client[quantitative_case_ids][] array. The hidden field clears the set when
      -# everything is deselected (unchecked multi-selects post nothing).
      - if @quantitative_types.present?
        %hr
        %h4.m-b-sm= t('.quantitative_data', default: 'Quantitative data')
        = hidden_field_tag 'client[quantitative_case_ids][]', ''
        .row
          - @quantitative_types.each do |qtype|
            .col-12.col-sm-6.col-md-4.mb-3
              %label.form-label{ for: "client_quantitative_type_#{qtype.id}" }= qtype.name
              = select_tag 'client[quantitative_case_ids][]', options_for_select(qtype.quantitative_cases.map { |qc| [qc.value, qc.id] }, @client.quantitative_case_ids), multiple: qtype.allow_multiple?, include_blank: (qtype.allow_multiple? ? false : ''), class: 'form-select', id: "client_quantitative_type_#{qtype.id}"
              - if qtype.description.present?
                %small.text-muted= qtype.description

  .ibox-footer
    %button.btn.btn-primary.form-btn#submit-button{ type: 'button' }
      = t('save')
    - if @client.persisted?
      = link_to t('cancel'), client_path(@client), class: 'btn btn-outline-secondary form-btn'
    - else
      = link_to t('cancel'), clients_path, class: 'btn btn-outline-secondary form-btn'

= render 'confirm_client'
