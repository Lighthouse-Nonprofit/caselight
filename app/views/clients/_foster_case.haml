- if fc.present?
  .col-12.col-sm-12.col-md-6.case#case
    .ibox
      .ibox-title
        %h5 Resettlement Case
        .ibox-tools
          - if can? :manage, Case
            - if current_user.admin? || current_user.case_worker? || current_user.fc_manager? || current_user.manager?
              %small
                = link_to edit_client_case_path(fc.client, fc) do
                  .btn.btn-outline.btn-success
                    = t('.edit_btn')
                - unless @client.cases.exclude_referred.latest_foster.exited
                  %button.btn.btn-outline.btn-warning{"data-bs-target" => '#exit-from-case', "data-bs-toggle" => 'modal'}
                    = t('.exit_btn')
      .ibox-content
        %section.overflow-case
          %table.table.table-bordered
            %tr
              %td.spacing-first-col Intake Date
              %td
                %strong
                  = fc.start_date.strftime('%B %d, %Y') if fc.start_date
            %tr
              %td.spacing-first-col Household
              %td
                %strong
                  = family fc.family if fc.family
            %tr
              %td.spacing-first-col Case Manager
              %td
                %strong
                  = @client.users.map(&:name).join(', ')
            %tr
              %td.spacing-first-col Status
              %td
                %strong
                  = @client.status.to_s.sub(/\AActive .*/, 'Active')
          -# (UX review 2: enrolled programs live in the adjacent Programs card — not repeated here.)
  = render 'exit_case_form', client_case: @client.cases.exclude_referred.latest_foster, exit_from_cif: false
