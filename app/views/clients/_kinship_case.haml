- if kc.present?
  .col-12.col-sm-12.col-md-6.case#case
    .ibox
      .ibox-title
        %h5 Resettlement Case
        .ibox-tools
          - if can? :manage, Case
            - if current_user.admin? || current_user.case_worker? || current_user.kc_manager? || current_user.manager?
              %small
                = link_to edit_client_case_path(kc.client, kc) do
                  .btn.btn-outline.btn-success
                    = t('.edit_btn')
                - unless @client.cases.exclude_referred.latest_kinship.exited
                  %button.btn.btn-outline.btn-warning{"data-bs-target" => '#exit-from-case', "data-bs-toggle" => 'modal'}
                    = t('.exit_btn')
      .ibox-content
        %section.overflow-case
          %table.table.table-bordered
            %tr
              %td.spacing-first-col Intake Date
              %td
                %strong
                  = kc.start_date.strftime('%B %d, %Y') if kc.start_date
            %tr
              %td.spacing-first-col Household
              %td
                %strong
                  = family kc.family if kc.family
            %tr
              %td.spacing-first-col Case Manager
              %td
                %strong
                  = @client.users.map(&:name).join(', ')
            %tr
              %td.spacing-first-col Status
              %td
                %strong
                  = @client.status.to_s.sub(/\AActive .*/, 'Active')
          %h5.m-t-sm.m-b-xs Enrolled programs
          %table.table.table-striped
            - @client.client_enrollments.includes(:program_stream).order(:enrollment_date).each do |ce|
              %tr
                %td
                  - if ce.program_stream
                    = link_to ce.program_stream.name, client_client_enrollment_path(@client, ce, program_stream_id: ce.program_stream_id)
                %td.text-right
                  %span.badge.text-bg-primary= ce.status
            - if @client.client_enrollments.empty?
              %tr
                %td.text-muted Not yet enrolled in a program.
  = render 'exit_case_form', client_case: @client.cases.exclude_referred.latest_kinship, exit_from_cif: false
