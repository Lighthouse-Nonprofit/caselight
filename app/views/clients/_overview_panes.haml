-# UX rung 5 — the Overview tab's summary panes. UX round 3: the Forms card moved to the Forms
-# partition page (A1) and the Resettlement Case card folded into the About table (A2) — the
-# row is now Programs | Recent program activity, side by side.
.row.client-overview
  .col-12.col-lg-6
    - programs_empty = @active_client_enrollments.blank? && @inactive_client_enrollments.blank?
    %div{ class: ibox_classes(collapsed: programs_empty) }
      .ibox-title
        %h5= t('clients.client_header.programs', default: 'Programs')
        .ibox-tools
          = render 'shared/ibox_collapse_link', collapsed: programs_empty
      .ibox-content
        - if can? :read, ClientEnrollment
          - if @active_client_enrollments.present?
            %h5.client-overview__subhead= t('clients.overview.active_programs', default: 'Active')
            %ul.client-overview__list
              - @active_client_enrollments.each do |client_enrollment|
                %li
                  -# Investor UX round (2026-07): deep-link to the program's PANE on the
                  -# Programs tab (?program_stream_id= selects the sub-tab server-side).
                  = link_to client_enrollment.program_stream.name, client_client_enrollments_path(@client, program_stream_id: client_enrollment.program_stream_id)
                  %span.text-muted= "· #{date_format(client_enrollment.enrollment_date)}"
          - if @inactive_client_enrollments.present?
            %h5.client-overview__subhead= t('clients.overview.exited_programs', default: 'Exited')
            %ul.client-overview__list
              - @inactive_client_enrollments.each do |client_enrollment|
                %li.text-muted
                  = link_to client_enrollment.program_stream.name, client_client_enrollments_path(@client, program_stream_id: client_enrollment.program_stream_id)
                  - if client_enrollment.leave_program
                    %span= "· #{t('clients.overview.exited', default: 'exited')} #{date_format(client_enrollment.leave_program.exit_date)}"
          - if @active_client_enrollments.blank? && @inactive_client_enrollments.blank?
            %p.text-muted= t('clients.overview.no_programs', default: 'Not yet enrolled in a program.')
          = link_to t('clients.overview.manage_programs', default: 'Manage programs'), client_client_enrollments_path(@client), class: 'btn btn-sm btn-outline-primary'
        - else
          %p.text-muted= t('clients.overview.no_program_access', default: 'You do not have access to program enrollments.')
  - if @recent_trackings.present?
    .col-12.col-lg-6
      .ibox
        .ibox-title
          %h5= t('clients.overview.recent_activity', default: 'Recent program activity')
          .ibox-tools
            = render 'shared/ibox_collapse_link'
        .ibox-content
          %ul.client-overview__list
            - @recent_trackings.each do |tracking|
              %li
                %span= tracking.client_enrollment.program_stream.try(:name)
                %span.text-muted= "· #{tracking.tracking.try(:name)} · #{date_format(tracking.created_at)}"
