#remaining-programs-modal.modal.fade{ 'aria-hidden' => 'true', role: 'dialog' }
  .modal-dialog
    .modal-content
      .modal-header.card-header
        %button.close{ 'aria-hidden' => 'true', 'data-bs-dismiss' => 'modal', type: 'button' } ×
        %h4.modal-title.text-center= t('.warning')
      .modal-body.text-center
        %p="This client is still actively enrolled in #{client.client_enrollments.active.count} programs. Please exit them from all programs before attempting to exit them from your organization."
        = link_to 'Click here to exit program', client_client_enrollments_path(@client, program_streams:'enrolled-program-streams') 
      .modal-footer
        %button.btn.btn-outline-secondary{ 'data-bs-dismiss' => 'modal', type: 'button' }
          = t('.close')
