= render 'shared/page_header',
  title: t('.title', default: 'Individuals'),
  filter_target: '#client-search-form',
  search: { url: clients_url, param: 'client_grid[given_name]', value: params.dig(:client_grid, :given_name), label: t('.quick_search_label', default: 'Search by given name (exact match)'), placeholder: t('.quick_search_placeholder', default: 'Given name (exact match)') },
  primary: ((can? :manage, Client) ? { label: t('.add_new_client'), url: new_client_path } : nil),
  secondary: [((can? :manage, :all) ? { label: t('.reports'), button: true, id: 'client-statistic' } : nil),
              { label: t('.advanced_search'), url: client_advanced_searches_path },
              { label: t('.view_all_active_tasks'), url: tasks_path },
              { label: t('.export_program_data'), url: current_url({format: 'xls', type: 'basic_info'}), class: 'btn-export' },
              { label: t('.export_to_xls'), url: current_url(format: 'xls'), class: 'btn-export' }]
.row
  .col-12
    = applied_filter_chips(:client_grid, scope: 'clients')
.row
  .col-12
    .ibox-content#client-advance-search-form.collapse

.row
  .col-12
    .ibox-content#client-search-form.collapse
      = datagrid_form_for @client_grid, url: clients_url, html: { class: 'grid-form' }
.row#client-statistic-body
  .col-12.mini-margin
    .ibox
      .row
        .col-12.col-md-6
          .ibox-content
            #cis-domain-score{ "data-csi-domain" => @csi_statistics, "data-title" => t('.csi_domain_scores'), "data-yaxis-title" => t('.domain_score')}

        .col-12.col-md-6
          .ibox-content
            #case-statistic{ "data-case-statistic" => @cases_statistics, "data-title" => t('.case_statistics'), "data-yaxis-title" => t('.client_amount') }
.row.mini-margin
  .col-12
    .ibox
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.results')
        %form.record-cards__sort{ method: 'get', action: clients_url, role: 'search', 'aria-label' => t('.sort_label', default: 'Sort individuals') }
          - (params[:client_grid] || {}).each do |k, v|
            - next if %w(order descending).include?(k.to_s)
            - if v.is_a?(Array)
              - v.each { |item| concat hidden_field_tag("client_grid[#{k}][]", item) }
            - else
              = hidden_field_tag("client_grid[#{k}]", v)
          %label.visually-hidden{ for: 'client_grid_order' }= t('.sort_label', default: 'Sort individuals')
          = select_tag 'client_grid[order]', options_for_select([[t('.sort_status', default: 'Status'), 'status'], [t('.sort_id', default: 'ID'), 'slug'], [t('.sort_age', default: 'Age'), 'age'], [t('.sort_province', default: 'State'), 'province']], params.dig(:client_grid, :order)), include_blank: t('.sort_default', default: 'Sort by…'), id: 'client_grid_order', class: 'form-select form-select-sm record-cards__sort-select', data: { auto_submit: true }
      .ibox-content
        %h2#clients-list-heading.visually-hidden= t('.grid_caption', default: 'Clients')
        - if current_user.admin? || current_user.strategic_overviewer?
          = render partial: 'clients/client_grid', locals: { clients: @client_grid.assets }
        - else
          %ul.record-cards{ role: 'list', 'aria-labelledby' => 'clients-list-heading', data: { 'info-load' => t('.load'), 'info-end' => t('.end') } }
            = render partial: 'clients/client_card', collection: @client_grid.assets, as: :object
        %span.d-none{ id: 'sinfo', 'data-infoshow' => t('.sInfoShow'), 'data-infoto' => t('.sInfoTo'), 'data-infototal' => t('.sInfoTotal') }
      .ibox-footer.text-center
        = paginate @client_grid.assets
