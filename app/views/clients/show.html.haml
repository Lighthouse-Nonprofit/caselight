.row
  .col-12
    = render 'clients/client_header', client: @client, active_tab: :overview, full_actions: true
    .row
      .col-md-9
      .col-md-3
        - if @client.state == ''
          .row
            .col-12
              .row
                .col-12
                  = simple_form_for @client, method: :put, url: client_path(@client) do |f|
                    .form-inputs
                      = f.hidden_field :state, value: 'accepted'
                      = f.hidden_field :accepted_date, value: Date.today
                    .form-actions
                      = f.submit t('.accept'), class: 'btn btn-success agree-btn'
                .col-12
                  %button.btn.btn-danger.mini-margin{"data-bs-target" => '#rejectionForm', "data-bs-toggle" => 'modal', class: 'agree-btn'} #{t('.reject')}
            .col-12
              #rejectionForm.modal.fade{ role: 'dialog', tabindex: '-1'}
                .modal-dialog{ role: 'document'}
                  .modal-content
                    .modal-header
                      %button.btn-close{"aria-label" => "#{t('close')}", "data-bs-dismiss" => 'modal'}
                      %h4.modal-title
                        = t('.reject_client')
                    .modal-body
                      = simple_form_for(@client) do |f|
                        = f.error_notification
                        .form-inputs
                          = f.input :rejected_note, required: true, label: "#{t('.note')}"
                        .form-inputs
                          = f.hidden_field :state, value: 'rejected'
                        .text-right
                          %button.btn.btn-outline-secondary{"data-bs-dismiss" => 'modal'} #{t('cancel')}
                          = f.button :submit, "#{t('.reject')}", class: 'btn btn-danger confirm-reject'

        - elsif @client.state == 'rejected'
          .row
            .col-12
              = simple_form_for @client, method: :put, url: client_path(@client) do |f|
                .form-inputs
                  = f.hidden_field :state, value: 'accepted'
                .form-actions
                  = f.submit "#{t('.accept')}", class: 'btn btn-success agree-btn'
            .col-12
              %button.btn.btn-danger.mini-margin{ disabled: 'disabled', class:'agree-btn' } #{t('.reject')}

    - if @client.state == 'accepted'
      -# Modals targeted by the hub header's "Open Resettlement Case" dropdown (rendered
      -# there with full_actions: true — the header lives above, the modals live here).
      - if can? :manage, Case
        - if @client.client_enrollments.active.count > 0
          = render 'remaining_programs', client: @client
        - else
          = render 'exit_ngo_form', client: @client
        - if @client.cases.exclude_referred.current.present?
          = render 'exit_case_form', client_case: @client.cases.exclude_referred.current, exit_from_cif: true
      .row
        .col-12
          -# Screening answers (the Add Form entry point lives in the Forms pane header; the
          -# break-glass affordance is the locked cards in the Forms pane).
          = render('client_answers')
      = render 'clients/overview_panes'
.row.mini-margin
  .col-12
    .ibox
      .ibox-title
        %h5=t('.general_info')
        .ibox-tools
          -# (UX rung 4: edit/delete moved to the hub header's Edit dropdown — one canonical spot.)
          %a.collapse-link
            .btn.btn-outline.btn-primary
              %i.fa.fa-chevron-up
      .ibox-content
        .row
          .col-sm-12.col-md-6.first-table
            %table.table.table-bordered
              %tr
                %td.spacing-first-col
                  = t('.families')
                %td
                  %strong
                    - @client.families.as_non_cases.uniq.each do |family|
                      %strong.badge.text-bg-light.family
                        - if can? :read, Family
                          = link_to family(family), family_path(family)
                        - else
                          = family(family)
              %tr
                %td.spacing-first-col
                  = t('.address')
                %td
                  %strong
                    - if @client.current_address.present?
                      = @client.current_address
                    - else
                      = merged_address(@client)
              / %tr
              /   %td.spacing-first-col
              /     = t('.completed')
              /   %td
              /     %strong
              /       = human_boolean(@client.completed)
              %tr
                %td.spacing-first-col
                  = t('.birth_province')
                %td
                  %strong
                    = @client.birth_province
          .col-sm-12.col-md-6.second-table
            %table.table.table-bordered
              %tr
                %td.spacing-first-col
                  = t('.school_name')
                %td
                  %strong
                    = @client.school_name
              %tr
                %td.spacing-first-col
                  = t('.school_grade')
                %td
                  %strong
                    = @client.grade
              %tr
                %td.spacing-first-col
                  = t('.relevant_referral_information')
                %td
                  %strong
                    = @client.relevant_referral_information
              %tr
                %td.spacing-first-col
                  = t('.case_worker_or_staff')
                %td
                  %strong
                    - order_case_worker(@client).each do |case_worker|
                      %strong.badge.text-bg-light
                        = user case_worker
              %tr
                %td.spacing-first-col
                  = t('.agencies_involved')
                %td
                  - @client.agencies.each do|agency|
                    %strong.badge.text-bg-light.agency
                      = agency.name

              = render 'state'
              - if @client.exit_date
                %tr
                  %td.spacing-first-col
                    = t('.accepted_date')
                  %td
                    %strong
                      = date_format(@client.accepted_date)
                %tr
                  %td.spacing-first-col
                    = t('.exit_date')
                  %td
                    %strong
                      = date_format(@client.exit_date)
                %tr
                  %td.spacing-first-col
                    = t('.exit_note')
                  %td
                    %strong
                      = @client.exit_note

        .row
          .col-12
            %table.table.table-bordered
              - @client.quantitative_cases.group_by(&:quantitative_type).each do |qtypes|
                %tr
                  %td.align-justify
                    = qtypes.first.name
                  %td.align-justify
                    - qtypes.last.each do |qcase|
                      %strong.badge.text-bg-light
                        = qcase.value
.row
  = render 'placement'
