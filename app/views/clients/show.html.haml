.row
  .col-12
    = render 'clients/client_header', client: @client, active_tab: :overview
    .row
      .col-md-9
      .col-md-3
        - if @client.state == ''
          .row
            .col-12
              .row
                .col-12
                  = simple_form_for @client, method: :put, url: client_path(@client) do |f|
                    .form-inputs
                      = f.hidden_field :state, value: 'accepted'
                      = f.hidden_field :accepted_date, value: Date.today
                    .form-actions
                      = f.submit t('.accept'), class: 'btn btn-success agree-btn'
                .col-12
                  %button.btn.btn-danger.mini-margin{"data-bs-target" => '#rejectionForm', "data-bs-toggle" => 'modal', class: 'agree-btn'} #{t('.reject')}
            .col-12
              #rejectionForm.modal.fade{ role: 'dialog', tabindex: '-1'}
                .modal-dialog{ role: 'document'}
                  .modal-content
                    .modal-header
                      %button.btn-close{"aria-label" => "#{t('close')}", "data-bs-dismiss" => 'modal'}
                      %h4.modal-title
                        = t('.reject_client')
                    .modal-body
                      = simple_form_for(@client) do |f|
                        = f.error_notification
                        .form-inputs
                          = f.input :rejected_note, required: true, label: "#{t('.note')}"
                        .form-inputs
                          = f.hidden_field :state, value: 'rejected'
                        .text-right
                          %button.btn.btn-outline-secondary{"data-bs-dismiss" => 'modal'} #{t('cancel')}
                          = f.button :submit, "#{t('.reject')}", class: 'btn btn-danger confirm-reject'

        - elsif @client.state == 'rejected'
          .row
            .col-12
              = simple_form_for @client, method: :put, url: client_path(@client) do |f|
                .form-inputs
                  = f.hidden_field :state, value: 'accepted'
                .form-actions
                  = f.submit "#{t('.accept')}", class: 'btn btn-success agree-btn'
            .col-12
              %button.btn.btn-danger.mini-margin{ disabled: 'disabled', class:'agree-btn' } #{t('.reject')}

    -# (UX round 3 A3: the exit modals moved into _client_header — one render, every hub page.)
.row.mini-margin
  .col-12
    .ibox
      .ibox-title
        %h5=t('.general_info')
        .ibox-tools
          -# (UX rung 4: edit/delete moved to the hub header's Edit dropdown — one canonical spot.)
          = render 'shared/ibox_collapse_link'
      .ibox-content
        -# UX round 4 (R4-3): the two bordered About tables + the quantitative table merged
        -# into ONE responsive label-over-value info grid (shared/_info_grid). Label/value
        -# TEXT is byte-identical to the tables it replaces (spec contract).
        - items = []
        -# Pre-production polish (2026-07-31): ONE Household row. The old pair — a
        -# "Households" item (non-case family types) + a "Case household" item from the
        -# case rows — was an upstream care-placement distinction that reads as a dupe
        -# here (membership is always through the case). All linked households, deduped.
        - families_html = capture do
          - @client.families.uniq.each do |family|
            %strong.badge.text-bg-light.family
              - if can? :read, Family
                = link_to family(family), family_path(family)
              - else
                = family(family)
        - items << info_item(t('.household', default: 'Household'), families_html.presence)
        - items << info_item(t('.address'), @client.current_address.presence || merged_address(@client))
        -# Youth flavor: Country of Origin (birth_province) is a resettlement concept — hidden.
        -# And school collapses to the ONE hub-linked 'School' quantitative (in the quantitative
        -# table below) — the legacy free-text school_name is hidden here too.
        - youth_flavor = Rails.application.config.x.flavor == 'youth'
        - items << info_item(t('.birth_province'), @client.birth_province) unless youth_flavor
        - items << info_item(t('.school_name'), @client.school_name) unless youth_flavor
        - items << info_item(t('.school_grade'), @client.grade)
        -# OCA 2026-08-26: "Lives with" is now a closed list and was previously not shown at all.
        - items << info_item(t('.live_with'), @client.live_with_label.presence)
        - items << info_item(t('.relevant_referral_information'), @client.relevant_referral_information)
        - case_workers_html = capture do
          - order_case_worker(@client).each do |case_worker|
            %strong.badge.text-bg-light
              = user case_worker
        - items << info_item(t('.case_worker_or_staff'), case_workers_html.presence)
        -# Investor UX round (2026-07): cross-record links — agencies/donor/referral source
        -# values link to their (index) pages when the viewer can read them (no show routes
        -# exist for these reference records). Donor + Referral Source rows are NEW: they were
        -# invisible outside the edit form.
        -# Youth uses campus + site (the schools/sites surfaces) rather than a generic
        -# "Agencies involved" row on the record (OCA feedback 2026-08-26). The association is
        -# still load-bearing for those surfaces - only this row is hidden.
        - unless youth_flavor
          - agencies_html = capture do
            - @client.agencies.each do |agency|
              %strong.badge.text-bg-light.agency
                - if can? :read, Agency
                  = link_to agency.name, agencies_path
                - else
                  = agency.name
          - items << info_item(t('.agencies_involved'), agencies_html.presence)
        - donor_html = capture do
          - if @client.donor.present?
            %strong.badge.text-bg-light.donor
              - if can? :read, Donor
                = link_to @client.donor.name, donors_path
              - else
                = @client.donor.name
        - items << info_item(t('.donor'), donor_html.presence)
        -# @client is decorated and ClientDecorator#referral_source returns the NAME string —
        -# go through .object for the association.
        - referral_record = @client.object.referral_source
        - referral_source_html = capture do
          - if referral_record.present?
            %strong.badge.text-bg-light.referral-source
              - if can? :read, ReferralSource
                = link_to referral_record.name, referral_sources_path
              - else
                = referral_record.name
        - items << info_item(t('.referral_source'), referral_source_html.presence)
        = render 'state', items: items
        -# UX round 3 (A2): the Resettlement Case facts (item-appender since R4-3).
        = render 'about_case_rows', client: @client, items: items
        - if @client.exit_date
          - items << info_item(t('.accepted_date'), date_format(@client.accepted_date))
          - items << info_item(t('.exit_date'), date_format(@client.exit_date))
          - items << info_item(t('.exit_note'), @client.exit_note)
        - @client.quantitative_cases.group_by(&:quantitative_type).each do |qtypes|
          - qvalues_html = capture do
            - qtypes.last.each do |qcase|
              %strong.badge.text-bg-light
                = qcase.value
          - items << info_item(qtypes.first.name, qvalues_html.presence)
        = render 'shared/info_grid', items: items
-# UX review 1: About Individual leads; the Programs | Resettlement Case | Forms cards sit
-# just under it (the placement partial renders inside the overview row); screening answers
-# and recent activity follow.
- if @client.state == 'accepted'
  = render 'clients/overview_panes'
  -# Investor UX round (2026-07): filled custom forms as collapsed sections, below the panes.
  = render 'clients/custom_form_sections'
  .row
    .col-12
      = render('client_answers')
