.ibox
  = simple_form_for([@custom_formable, @custom_field_property]) do |f|
    = hidden_field_tag :custom_field_id, @custom_field.id
    .ibox-title
      %h5= @custom_field.form_title
    .ibox-content

      - if @custom_field.present?
        = f.simple_fields_for :properties, OpenStruct.new(@custom_field_property.properties) do |prop_f|
          - @custom_field.fields.each_slice(2) do |n_field|
            .row
              - n_field.each do |field|
                .col-12.col-md-6
                  - unless field['type'] == 'file'
                    = render "/shared/fields/#{field['type'].underscore}", f: prop_f, field_props: field, errors: @custom_field_property.errors.messages

                  - else
                    = f.simple_fields_for :form_builder_attachments, custom_field_property_attachment(field['label']) do |attachment|
                      = render 'shared/form_builder/attachment', f: attachment, property: field, entity: f, resource: @custom_field_property
        .row
          .col-12
            #message.text-danger
    .ibox-footer
      = f.submit t('.save'), class: 'btn btn-primary form-btn'
      = link_to t('.cancel'), polymorphic_path([@custom_formable, CustomFieldProperty], custom_field_id: @custom_field), class: 'btn btn-outline-secondary form-btn'
      -# Investor UX round (2026-07): delete lives on the EDIT page (show_delete — never new),
      -# destructive control last/outermost per docs/ui-conventions.md.
      - if local_assigns[:show_delete] && @custom_field_property.persisted? && (can? :destroy, @custom_field_property)
        = link_to polymorphic_path([@custom_formable, @custom_field_property], custom_field_id: @custom_field), method: :delete, data: { confirm: t('are_you_sure') }, class: 'btn btn-outline-danger form-btn action-gap-start' do
          = t('shared.actions.delete', default: 'Delete')
