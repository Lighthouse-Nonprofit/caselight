.row
  .col-12
    -# The page is polymorphic (Client/Family/Partner/User) — Client and Family records get
    -# their hub headers (UX round 3 B1); Partner/User keep their Back button.
    - if @custom_formable.is_a?(Client)
      = render 'clients/client_header', client: @custom_formable, active_tab: client_hub_active_tab
    - elsif @custom_formable.is_a?(Family)
      = render 'families/family_header', family: @custom_formable, active_tab: family_hub_active_tab
    .ibox
      .ibox-title
        %h5= @custom_field.form_title
        .ibox-tools
          - if can? :manage, CustomFieldProperty
            = link_to new_polymorphic_path([@custom_formable, CustomFieldProperty], custom_field_id: @custom_field.id) do
              .btn.btn-outline.btn-primary.form-btn
                = "#{t('.add_new')} #{@custom_field.form_title}"
            - unless @custom_formable.is_a?(Client) || @custom_formable.is_a?(Family)
              = link_to polymorphic_path(@custom_formable) do
                .btn.btn-outline.btn-success.form-btn
                  = t('.back')
      .ibox-content
        - @custom_field_properties.each do |custom_field_property|
          .row
            .col-12
              .ibox.border-left-right.border-bottom
                .ibox-title
                  %h5
                    = t('.created_date')
                  %span.badge.text-bg-info
                    = date_format custom_field_property.created_at
                  .ibox-tools
                    -# Investor UX round (2026-07): the trash left the entry cards — Delete now
                    -# lives on the EDIT page footer; the pencil became a labeled Edit button.
                    - if can? :manage, CustomFieldProperty
                      %small
                        = link_to edit_polymorphic_path([@custom_formable, custom_field_property], custom_field_id: @custom_field) do
                          .btn.btn-outline.btn-success.btn-xs= t('shared.actions.edit', default: 'Edit')
                .ibox-content
                  -# UX round 4 (R4-4): field table -> the info grid (natural-case labels).
                  = render 'shared/info_grid', items: custom_field_info_items(custom_field_property.custom_field.fields, custom_field_property), variant: 'info-grid--natural-case'
      .ibox-footer.text-center
        = paginate @custom_field_properties
