.col-12
  .card.client-card
    .card-body
      .widget.style1.widget-client-card
        .row.vertical-align
          .col-3
            %i.fa.fa-child.fa-3x
          .col-9.text-right
            %span.text-font
              = t('.clients')
            %h2.font-bold= @dashboard.clients.all_active_types.count
      .row
        .col-12.col-md-6
          #client-by-gender{ 'data-content-count' => @dashboard.client_gender_statistic.to_json}
        .col-12.col-md-6
          #client-by-status{ 'data-content-count' => @dashboard.client_status_statistic.to_json}
