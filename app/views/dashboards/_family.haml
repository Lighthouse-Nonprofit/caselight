.col-12.col-md-6
  .card.family-card
    .card-body
      =link_to families_path do
        .widget.style1.widget-family-card
          .row.vertical-align
            .col-5
              %i.fa.fa-users.fa-3x
            .col-7.text-right
              %span.text-font
                = t('.families')
              %h2.font-bold #{@dashboard.family_count}
      .row
        .col-12
          #family-type{ 'data-content-count' => @dashboard.family_type_statistic.to_json }
        
