#home-index
  .row
    .col-lg-12
      -# Investor UX round (2026-07): vertical-neutral + i18n (was hardcoded "Resettlement
      -# Dashboard" — flavors override these keys in their locale overlay).
      %h2.m-t-none.m-b-xs= t('.title', default: 'Dashboard')
      %p.text-muted= t('.subtitle', default: 'Households and individuals across your active programs.')
  -# UX rung 6: stat tiles are links now (can?-gated — a case worker cannot :read Family).
  .row
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center
          = link_to_if (can? :read, Family), content_tag(:h1, Family.count, class: 'font-bold m-b-none') + content_tag(:small, t('.tile_households', default: 'HOUSEHOLDS'), class: 'text-muted'), families_path, class: 'dashboard-tile-link'
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center
          = link_to_if (can? :read, Client), content_tag(:h1, Client.count, class: 'font-bold m-b-none') + content_tag(:small, t('.tile_individuals', default: 'INDIVIDUALS'), class: 'text-muted'), clients_path, class: 'dashboard-tile-link'
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center
          = link_to_if (can? :read, ProgramStream), content_tag(:h1, ClientEnrollment.where(status: 'Active').count, class: 'font-bold m-b-none') + content_tag(:small, t('.tile_active_enrollments', default: 'ACTIVE PROGRAM ENROLLMENTS'), class: 'text-muted'), program_streams_path, class: 'dashboard-tile-link'
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center
          = link_to_if (can? :read, ProgramStream), content_tag(:h1, ProgramStream.count, class: 'font-bold m-b-none') + content_tag(:small, t('.tile_programs_offered', default: 'PROGRAMS OFFERED'), class: 'text-muted'), program_streams_path, class: 'dashboard-tile-link'
  -# UX review 1 — activity flash metrics. Research-backed: a small set of workload/activity
  -# signals (overdue work, today's work, intake velocity, service-use frequency) beats a
  -# long list; sources in the PR. All four are single COUNT queries.
  .row
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center.dashboard-flash{ class: (Task.overdue_incomplete.count.positive? ? 'dashboard-flash--alert' : nil) }
          = link_to_if (can? :read, Task), content_tag(:h2, Task.overdue_incomplete.count, class: 'font-bold m-b-none') + content_tag(:small, t('.tile_overdue_tasks', default: 'OVERDUE TASKS'), class: 'text-muted'), tasks_path, class: 'dashboard-tile-link'
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center.dashboard-flash
          = link_to_if (can? :read, Task), content_tag(:h2, Task.today_incomplete.count, class: 'font-bold m-b-none') + content_tag(:small, t('.tile_tasks_due_today', default: 'TASKS DUE TODAY'), class: 'text-muted'), tasks_path, class: 'dashboard-tile-link'
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center.dashboard-flash
          = link_to_if (can? :read, Client), content_tag(:h2, Client.where(created_at: Time.zone.now.beginning_of_month..).count, class: 'font-bold m-b-none') + content_tag(:small, t('.tile_new_individuals', default: 'NEW INDIVIDUALS THIS MONTH'), class: 'text-muted'), clients_path, class: 'dashboard-tile-link'
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center.dashboard-flash
          %h2.font-bold.m-b-none= ClientEnrollmentTracking.where(created_at: Time.zone.now.beginning_of_month..).count
          %small.text-muted= t('.tile_check_ins', default: 'CHECK-INS THIS MONTH')
  .row
    .col-lg-6
      .ibox
        .ibox-title
          %h5= t('.section_enrollments', default: 'Active enrollments by program')
        .ibox-content
          .table-responsive
            %table.table.table-striped.m-b-none
              %tbody
                - ProgramStream.order(:name).each do |ps|
                  %tr
                    %td= link_to_if (can? :read, ProgramStream), ps.name, program_stream_path(ps)
                    %td.text-right
                      %span.badge.text-bg-primary= ps.client_enrollments.where(status: 'Active').count
    .col-lg-6
      .ibox
        .ibox-title
          %h5= t('.section_households', default: 'Households')
        .ibox-content
          .table-responsive
            %table.table.table-striped.m-b-none
              %tbody
                - Family.order(:name).each do |fam|
                  %tr
                    %td= link_to_if (can? :read, Family), fam.name, family_path(fam)
                    %td.text-right= pluralize(fam.clients.count, t('.member_noun', default: 'member'))
  .row
    .col-lg-12
      .ibox
        .ibox-title
          %h5= t('.section_activity', default: 'Recent program activity')
        .ibox-content
          .table-responsive
            %table.table.table-striped.m-b-none
              %thead
                %tr
                  %th= t('.col_individual', default: 'Individual')
                  %th= t('.col_program', default: 'Program')
                  %th= t('.col_update', default: 'Update')
                  %th.text-right= t('.col_logged', default: 'Logged')
              %tbody
                - ClientEnrollmentTracking.order(created_at: :desc).limit(8).each do |cet|
                  - ce = cet.client_enrollment
                  - next if ce.nil?
                  %tr
                    %td
                      - name = [ce.client.try(:given_name), ce.client.try(:family_name)].compact.join(' ')
                      = link_to_if (ce.client && (can? :read, Client)), name, (ce.client ? client_path(ce.client) : '#')
                    %td= ce.program_stream.try(:name)
                    %td= cet.tracking.try(:name)
                    %td.text-right= cet.created_at.strftime('%b %d, %Y')
