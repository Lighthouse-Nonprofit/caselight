-# Data-task batch C4 (reworked next turn): the personal landing dashboard (every role
-# except admin + strategic overviewer, who keep the org index). Counts come scoped from
-# the controller (Task.of_user / accessible_by); the 7-day agenda is server-rendered —
-# every day gets a row so an empty week still reads as a structured schedule.
#personal-dashboard
  .row
    .col-lg-12
      %h2.m-t-none.m-b-xs= t('.greeting', name: (current_user.first_name.presence || current_user.email), default: 'Welcome back, %{name}')
      %p.text-muted= t('.subtitle', default: 'Your tasks and caseload for the week ahead.')
  .row
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center.dashboard-flash{ class: (@overdue_count.positive? ? 'dashboard-flash--alert' : nil) }
          = link_to content_tag(:h2, @overdue_count, class: 'font-bold m-b-none') + content_tag(:small, t('.overdue', default: 'MY OVERDUE TASKS'), class: 'text-muted'), tasks_path, class: 'dashboard-tile-link'
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center.dashboard-flash
          = link_to content_tag(:h2, @today_count, class: 'font-bold m-b-none') + content_tag(:small, t('.today', default: 'DUE TODAY'), class: 'text-muted'), tasks_path, class: 'dashboard-tile-link'
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center.dashboard-flash
          = link_to content_tag(:h2, @week_count, class: 'font-bold m-b-none') + content_tag(:small, t('.week', default: 'NEXT 7 DAYS'), class: 'text-muted'), tasks_path, class: 'dashboard-tile-link'
    .col-lg-3.col-sm-6
      .ibox
        .ibox-content.text-center
          = link_to content_tag(:h1, @caseload_count, class: 'font-bold m-b-none') + content_tag(:small, t('.caseload', default: 'MY CASELOAD'), class: 'text-muted'), clients_path, class: 'dashboard-tile-link'
  .row
    .col-lg-12
      .ibox
        .ibox-title
          %h5= t('.agenda_title', default: 'Your next 7 days')
        .ibox-content.agenda-week
          - @week_days.each do |day|
            - day_tasks = @agenda_by_day[day] || []
            .agenda-day{ class: (day == Time.zone.today ? 'agenda-day--today' : nil) }
              .agenda-day__rail
                .agenda-day__dow= day == Time.zone.today ? t('.today_label', default: 'Today') : day.strftime('%a')
                .agenda-day__date= day.strftime('%b %-d')
              .agenda-day__body
                - if day_tasks.empty?
                  .agenda-empty
                    %span.agenda-empty__text= t('.nothing_scheduled', default: 'Nothing scheduled')
                - else
                  - day_tasks.each do |task|
                    -# Demo UX polish — open the task detail modal (edit/delete/complete) in place
                    -# instead of bouncing to the client's task list.
                    %button.agenda-task.border-0.bg-transparent.w-100.text-start{ type: 'button', 'data-bs-toggle': 'modal', 'data-bs-target': "#taskModal-#{task.id}" }
                      %span.agenda-task__time
                        = task.timed? ? task.starts_at.strftime('%l:%M %p').strip : t('.all_day', default: 'All day')
                      %span.agenda-task__title= task.name
                      %span.agenda-task__person= entity_name(task.client)
  -# task detail modals for the agenda (edit/delete/complete from the dashboard)
  - @agenda_by_day.values.flatten.uniq.each do |task|
    = render 'tasks/task_modal', task: task
