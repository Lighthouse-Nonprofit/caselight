.row
  .col-12.col-sm-6.offset-sm-3.col-md-4.offset-md-4
    .ibox.normal-space
      .ibox-title.text-center
        -# The tenant's own logo when it has one (Organization#logo, the no-code branding hook) —
        -# this is the first screen their staff see, so it should say who THEY are. Guarded with
        -# .file.present? like the error pages: logo.url falls back to a placeholder asset, so
        -# checking the URL would brand a logo-less tenant with a grey square.
        - org = Organization.current
        - if org && org.logo.file.present?
          = image_tag(org.logo.url, alt: org.full_name, style: 'max-width: 260px; width: 100%; height: auto;')
        - else
          = image_tag('brand/caselight-logo.png', alt: 'CaseLight', style: 'max-width: 260px; width: 100%; height: auto;')
      .ibox-content
        = simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
          = f.error_notification
          .form-inputs
            = f.input :email, required: false, autofocus: true, label: t('.email')
            = f.input :password, required: false, label: t('.password')
            -# Accounts with MFA enabled are prompted for their code on the next screen (two-step login).
            = f.input :remember_me, as: :boolean, input_html: { class: 'form-check-input' }, label: t('.remember_me') if devise_mapping.rememberable?
            = f.submit t('.login'), class: 'btn btn-primary w-100'
            -# Passwordless passkey sign-in (WebAuthn) — ADDITIVE third option. Hidden if the browser
            -# lacks WebAuthn support / is not a secure context (the sessions/new_passkey asset reveals it).
            #passkey-login-area{ style: 'display:none', data: { options_url: passkey_login_options_path, callback_url: passkey_login_callback_path } }
              %hr
              %button#passkey-login.btn.btn-outline-secondary.w-100{ type: 'button' }
                %i.fa.fa-key
                = ' Sign in with a passkey'
              %p#passkey-login-status.text-danger.text-center.m-t{ style: 'display:none' }
            %noscript
              %p.text-muted.text-center.m-t Passkey sign-in requires JavaScript.
            .text-center
              %hr
              = render "devise/shared/links"
