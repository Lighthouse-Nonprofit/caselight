.row
  .col-12
    .ibox
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.donors')
        .ibox-tools
          - if can? :manage?, Donor
            = link_to '#', {"data-bs-target" => "#donorModal-", "data-bs-toggle" => "modal", :type => "button"} do
              .btn.btn-primary.btn-add
                = t('.add_new_donor')
      .ibox-content
        .table-responsive
          %table.table.table-bordered.table-striped.table-hover
            %thead
              %tr
                %th.name= t('.donor_names')
                %th.code= t('.code')
                %th.donor_type= t('.donor_type', default: 'Type')
                %th.status= t('.status', default: 'Status')
                %th.contact= t('.contact', default: 'Contact')
                %th.clients= t('.clients')
                - if can? :manage, Donor
                  %th.text-center.custom_column_manage{ colspan: '2' }= t('.manage')
                - if can? :version, Donor
                  %th.changelog.text-center= t('.changelogs')
            %tbody
              - @donors.each do |donor|
                %tr
                  %td= donor.name
                  %td= donor.code
                  %td= donor.donor_type
                  %td
                    - if donor.status.present?
                      %span.badge.text-bg-light= donor.status
                  %td
                    - if donor.contact_name.present?
                      %div= donor.contact_name
                    - if donor.email.present?
                      %div.text-muted.small= donor.email
                  %td
                    -# Investor UX round (2026-07): accessible_by-scoped for consistency with the
                    -# agencies/referral-sources columns (only admin + strategic overviewer can
                    -# reach this page today, and both hold org-wide client read — no live leak).
                    - donor.clients.accessible_by(current_ability).each do |client|
                      %strong.badge.text-bg-light.client
                        = link_to entity_name(client), client_path(client)
                  - if can? :manage, Donor
                    %td.text-center
                      = link_to '#', {class: 'btn btn-outline btn-success btn-xs',
                                      'data-bs-target': "#donorModal-#{donor.id}",
                                      'data-bs-toggle': 'modal', type: 'button'} do
                        = fa_icon('pencil')
                    %td.text-center
                      = remove_link(donor, donor_client: donor.clients.count)
                  - if can? :version, Donor
                    %td.text-center
                      = link_to t('.view'), donor_version_path(donor)
                  = render 'form', donor: donor
      .ibox-footer.text-center
        = paginate @donors
= render 'form'
