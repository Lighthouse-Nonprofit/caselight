-# Limited grid for admin? / strategic_overviewer? on families#index.
- type_labels = { 'birth_family' => 'Household', 'emergency' => 'Priority Intake', 'foster' => 'Sponsor Household', 'inactive' => 'Closed', 'kinship' => 'Active' }
.record-grid
  %table.record-grid__table{ role: 'table' }
    %caption.sr-only= t('.grid_caption', default: 'Households')
    %thead
      %tr
        %th{ scope: 'col' }= t('datagrid.columns.families.name', default: 'Name')
        %th{ scope: 'col' }= t('datagrid.columns.families.code', default: 'Code')
        %th{ scope: 'col' }= t('datagrid.columns.families.family_type', default: 'Type')
        %th{ scope: 'col' }= t('datagrid.columns.families.clients', default: 'Members')
        %th{ scope: 'col' }= t('datagrid.columns.families.province', default: 'State')
        %th.record-grid__actions-col{ scope: 'col' }
          %span.sr-only= t('datagrid.columns.families.manage', default: 'Actions')
    %tbody
      - families.each do |object|
        - type_label = type_labels[object.family_type] || object.family_type.to_s.titleize
        %tr.record-grid__row
          %th.record-grid__name{ scope: 'row' }
            = link_to entity_name(object), family_path(object), class: 'record-grid__name-link'
          %td.record-grid__code
            - if object.code.present?
              %span.record-grid__slug= object.code
          %td.record-grid__type
            %span.record-grid__tag.record-grid__tag--type= type_label
          %td.record-grid__members
            = family_member_chips(object)
          %td.record-grid__province
            - if object.province.try(:name).present?
              = object.province.name
            - else
              %span.record-grid__empty{ 'aria-hidden' => 'true' } —
          %td.record-grid__actions.text-center
            = link_to family_path(object), class: 'btn btn-xs btn-info btn-outline', 'aria-label' => (t('shared.actions.view', default: 'View') + ' ' + entity_name(object).to_s) do
              = fa_icon('eye', 'aria-hidden': true)
            = render partial: 'families/actions', locals: { object: object }
