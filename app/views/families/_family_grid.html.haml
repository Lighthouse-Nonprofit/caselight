-# Limited grid for admin? / strategic_overviewer? on families#index.
.record-grid
  %table.record-grid__table{ role: 'table' }
    %caption.visually-hidden= t('.grid_caption', default: 'Households')
    %thead
      %tr
        %th{ scope: 'col' }= t('datagrid.columns.families.name', default: 'Name')
        %th{ scope: 'col' }= t('datagrid.columns.families.code', default: 'Code')
        %th{ scope: 'col' }= t('datagrid.columns.families.clients', default: 'Members')
        %th{ scope: 'col' }= t('datagrid.columns.families.province', default: 'State')
    %tbody
      - families.each do |object|
        %tr.record-grid__row{ class: ('record-grid__row--muted' if object.family_type == 'inactive') }
          %th.record-grid__name{ scope: 'row' }
            = link_to entity_name(object), family_path(object), class: 'record-grid__name-link'
          %td.record-grid__code
            - if object.code.present?
              %span.record-grid__slug= object.code
          %td.record-grid__members
            = family_member_chips(object)
          %td.record-grid__province
            - if object.province.try(:name).present?
              = object.province.name
            - else
              %span.record-grid__empty{ 'aria-hidden' => 'true' } —
