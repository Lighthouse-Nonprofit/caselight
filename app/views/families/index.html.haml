= render 'shared/page_header',
  title: t('.title', default: 'Households'),
  filter_target: '#family-search-form',
  primary: ((can? :manage, Family) ? { label: t('families.index.add_new_family'), url: new_family_path } : nil),
  secondary: [{ label: t('families.index.export_xls'), url: current_url(format: 'xls'), class: 'btn-export' }]
.row
  .col-12
    = applied_filter_chips(:family_grid, scope: 'families')

.row.ibox-space
  .col-12
    .ibox-content#family-search-form.collapse
      = datagrid_form_for @family_grid, url: families_url, html: { class: 'grid-form' }
.row
  .col-12
    .ibox.float-e-margins
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.results')
        %form.record-cards__sort{ method: 'get', action: families_url, role: 'search', 'aria-label' => t('.sort_label', default: 'Sort households') }
          - (params[:family_grid] || {}).each do |k, v|
            - next if %w(order descending).include?(k.to_s)
            - if v.is_a?(Array)
              - v.each { |item| concat hidden_field_tag("family_grid[#{k}][]", item) }
            - else
              = hidden_field_tag("family_grid[#{k}]", v)
          %label.visually-hidden{ for: 'family_grid_order' }= t('.sort_label', default: 'Sort households')
          = select_tag 'family_grid[order]', options_for_select([[t('.sort_name', default: 'Name'), 'name'], [t('.sort_members', default: 'Members'), 'member_count'], [t('.sort_province', default: 'State'), 'province']], params.dig(:family_grid, :order)), include_blank: t('.sort_default', default: 'Sort by…'), id: 'family_grid_order', class: 'form-select form-select-sm record-cards__sort-select', data: { auto_submit: true }
      .ibox-content
        %h2#families-list-heading.visually-hidden= t('.card_list_label', default: 'Households')
        - if current_user.admin? || current_user.strategic_overviewer?
          = render partial: 'families/family_grid', locals: { families: @family_grid.assets }
        - else
          %ul.record-cards{ role: 'list', 'aria-labelledby' => 'families-list-heading' }
            = render partial: 'families/family_card', collection: @family_grid.assets, as: :object
      .ibox-footer.text-center
        = paginate @family_grid.assets
