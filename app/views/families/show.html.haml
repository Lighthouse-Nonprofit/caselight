-# UX round 3 (B1) — family hub: persistent header + tabs replace the top form dropdowns
-# (forms live on the Forms tab) and the ibox pencil/trash (Edit/Delete live in Actions).
= render 'families/family_header', family: @family, active_tab: :overview
-# UX round 3 (B3) — "read first" active alerts, before anything else.
= render 'families/active_alerts_banner', family: @family
.row
  .col-12.family
    .ibox.mini-margin
      .ibox-title
        %h5= t('.general_info')
        .ibox-tools
          %a.collapse-link
            .btn.btn-outline.btn-primary
              %i.fa.fa-chevron-up
      .ibox-content
        -# UX round 4 (R4-3): the 16-row bordered table becomes the label-over-value info
        -# grid (label/value text unchanged — spec contract). .family-summary kept as a
        -# greppable wrapper class.
        .family-summary
          - items = []
          - items << info_item(t('.code'), @family.code)
          - items << info_item(t('.case_history'), family_case_history(@family))
          - items << info_item(t('.address'), @family.address)
          - items << info_item(t('.member_count'), pluralize(@family.member_count, 'Person'))
          - items << info_item(t('.caregiver_information'), @family.caregiver_information)
          - items << info_item(t('.significant_family_member_count'), @family.significant_family_member_count)
          - items << info_item(t('.household_income'), number_to_currency(@family.household_income))
          - items << info_item("#{t('.dependable_income')}?", human_boolean(@family.dependable_income))
          - items << info_item(t('.female_children_count'), @family.female_children_count.to_i)
          - items << info_item(t('.male_children_count'), @family.male_children_count.to_i)
          - items << info_item(t('.female_adult_count'), @family.female_adult_count.to_i)
          - items << info_item(t('.male_adult_count'), @family.male_adult_count.to_i)
          - items << info_item(t('.contract_date'), date_format(@family.contract_date))
          - items << info_item(t('.province'), @family.province.try(:name))
          - items << info_item(t('.family_type'), family_type_label(@family.family_type))
          = render 'shared/info_grid', items: items
.row
  .col-12.clients
    .ibox
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.results')
        .ibox-tools
          = render 'shared/ibox_collapse_link'
      .ibox-content
        %h6.household-members__heading= t('.household_members', default: 'Household members')
        - members = @family.clients.to_a.uniq
        - if members.any?
          %ul.household-members{ 'aria-label' => t('.household_members', default: 'Household members') }
            - members.each do |client|
              %li.household-members__item
                = link_to entity_name(client), client_path(client), class: 'household-members__link'
        - else
          %p.household-members__empty= t('.no_members', default: 'No household members on record.')
        .clients-table
          = datagrid_table @client_grid, html: { class: 'table table-bordered table-striped table-hover clients'}
      .ibox-footer.text-center
        = paginate @client_grid.assets
