-# UX round 3 (B1) — family hub: persistent header + tabs replace the top form dropdowns
-# (forms live on the Forms tab) and the ibox pencil/trash (Edit/Delete live in Actions).
= render 'families/family_header', family: @family, active_tab: :overview
-# UX round 3 (B3) — "read first" active alerts, before anything else.
= render 'families/active_alerts_banner', family: @family
.row
  .col-12.family
    .ibox.mini-margin
      .ibox-title
        %h5= t('.general_info')
        .ibox-tools
          %a.collapse-link
            .btn.btn-outline.btn-primary
              %i.fa.fa-chevron-up
      .ibox-content
        .row.family-summary
          .col-sm-12
            %table.table.table-bordered
              %tr
                %td.spacing-first-col
                  = t('.code')
                %td
                  %strong
                    = @family.code
              %tr
                %td.spacing-first-col
                  = t('.case_history')
                %td
                  %strong
                    = family_case_history(@family)
              %tr
                %td.spacing-first-col
                  = t('.address')
                %td
                  %strong
                    = @family.address

              %tr
                %td.spacing-first-col
                  = t('.member_count')
                %td
                  %strong
                    = pluralize(@family.member_count, 'Person')

              %tr
                %td.spacing-first-col
                  = t('.caregiver_information')
                %td
                  %strong
                    = @family.caregiver_information

              %tr
                %td.spacing-first-col
                  = t('.significant_family_member_count')
                %td
                  %strong
                    = @family.significant_family_member_count

              %tr
                %td.spacing-first-col
                  = t('.household_income')
                %td
                  %strong
                    = number_to_currency @family.household_income

              %tr
                %td.spacing-first-col
                  = "#{t('.dependable_income')}?"
                %td
                  %strong
                    = human_boolean(@family.dependable_income)

              %tr
                %td.spacing-first-col
                  = t('.female_children_count')
                %td
                  %strong
                    = @family.female_children_count.to_i

              %tr
                %td.spacing-first-col
                  = t('.male_children_count')
                %td
                  %strong
                    = @family.male_children_count.to_i

              %tr
                %td.spacing-first-col
                  = t('.female_adult_count')
                %td
                  %strong
                    = @family.female_adult_count.to_i

              %tr
                %td.spacing-first-col
                  = t('.male_adult_count')
                %td
                  %strong
                    = @family.male_adult_count.to_i
              %tr
                %td.spacing-first-col
                  = t('.contract_date')
                %td
                  %strong
                    = date_format(@family.contract_date)

              %tr
                %td.spacing-first-col
                  = t('.province')
                %td
                  %strong
                    = @family.province.try(:name)

              %tr
                %td.spacing-first-col
                  = t('.family_type')
                %td
                  %strong
                    = family_type_label(@family.family_type)
.row
  .col-12.clients
    .ibox
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.results')
        .ibox-tools
          = render 'shared/ibox_collapse_link'
      .ibox-content
        %h6.household-members__heading= t('.household_members', default: 'Household members')
        - members = @family.clients.to_a.uniq
        - if members.any?
          %ul.household-members{ 'aria-label' => t('.household_members', default: 'Household members') }
            - members.each do |client|
              %li.household-members__item
                = link_to entity_name(client), client_path(client), class: 'household-members__link'
        - else
          %p.household-members__empty= t('.no_members', default: 'No household members on record.')
        .clients-table
          = datagrid_table @client_grid, html: { class: 'table table-bordered table-striped table-hover clients'}
      .ibox-footer.text-center
        = paginate @client_grid.assets
