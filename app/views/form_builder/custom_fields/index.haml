.row
  .col-12.col-sm-8.col-md-8
    = form_tag search_custom_fields_path, method: 'get' do
      .row
        .col-9.col-sm-6.col-md-8.col-lg-4
          = text_field_tag :search, nil, class: 'form-control', placeholder: t('.form_title'), required: true
        .col-3.col-sm-6.col-md-4
          = submit_tag t('.search'), name: nil, class: 'btn btn-primary'
  .col-12.col-sm-4.col-md-4.text-right
    - if can? :manage, CustomField
      = link_to t('.new_custom_form'), new_custom_field_path, class: 'btn btn-primary form-btn no-margin-top'
.row
  .col-12
    .ibox.min-margin-layout
      .ibox-content
        %div
          %ul.nav.nav-tabs{role: "tablist"}
            %li.nav-item{role: "presentation"}
              %a.nav-link.active{"aria-controls" => "custom-form", "aria-selected" => "true", "data-bs-toggle" => "tab", href: "#custom-form", role: "tab"}= t('.my_ngo')
            - unless current_organization.try(:short_name) == 'mho'
              %li.nav-item{role: "presentation"}
                %a.nav-link{"aria-controls" => "all-custom-form", "aria-selected" => "false", "data-bs-toggle" => "tab", href: "#all-custom-form", role: "tab"}= t('.all_ngo')
          .tab-content
            = render 'current_custom_form_tab'
            - unless current_organization.try(:short_name) == 'mho'
              = render 'all_custom_form_tab'
