-# UX round 3 (A1) — the Forms partition page, Programs-page layout: a filled-forms table
-# (Form | Entries | Latest entry | Actions) with the break-glass locked rows folded in,
-# then the available-to-add forms. "View entries" -> custom_field_properties#index (the
-# dated-entries / "trackings" page). Polymorphic; the family header branch lands with B1.
.row
  .col-12
    - if @custom_formable.is_a?(Client)
      = render 'clients/client_header', client: @custom_formable, active_tab: client_hub_active_tab
    .ibox
      .ibox-title
        %h5= t('.filled_forms', default: 'Forms')
      .ibox-content
        - if @grouped_forms.any? || @breakglass_forms.any?
          .table-responsive
            %table.table.table-bordered.table-striped.table-hover.forms-table
              %thead
                %tr
                  %th= t('.form', default: 'Form')
                  %th= t('.entries', default: 'Entries')
                  %th= t('.latest_entry', default: 'Latest entry')
                  %th= t('.actions', default: 'Actions')
              %tbody
                - @grouped_forms.each do |custom_field_id, props|
                  %tr
                    %td= props.first.custom_field.form_title
                    %td= props.size
                    %td= date_format(props.map(&:created_at).max)
                    %td
                      = link_to polymorphic_path([@custom_formable, CustomFieldProperty], custom_field_id: custom_field_id) do
                        .btn.btn-primary.btn-xs.btn-width= t('.view_entries', default: 'View entries')
                      - if can? :manage, CustomFieldProperty
                        = link_to new_polymorphic_path([@custom_formable, CustomFieldProperty], custom_field_id: custom_field_id) do
                          .btn.btn-outline.btn-success.btn-xs.btn-width= t('.add_entry', default: 'Add entry')
                - @breakglass_forms.each do |custom_field|
                  %tr.forms__locked
                    %td
                      %i.fa.fa-lock.text-danger{ 'aria-hidden' => 'true' }
                      = custom_field.form_title
                      %span.text-muted= t('.locked_hint', default: '— access requires a logged reason, 1 hour')
                    %td= t('.locked', default: '—')
                    %td= t('.locked', default: '—')
                    %td
                      %button.btn.btn-xs.btn-outline-danger{ type: 'button', 'data-bs-toggle' => 'modal', 'data-bs-target' => "#break-glass-#{custom_field.id}" }
                        = t('.unlock', default: 'Request access')
        - else
          %p.text-muted= t('.no_forms', default: 'No forms filled yet.')
    - if can? :manage, CustomFieldProperty
      .ibox
        .ibox-title
          %h5= t('.available_forms', default: 'Available forms')
        .ibox-content
          - if @available_forms.any?
            .table-responsive
              %table.table.table-bordered.table-striped.table-hover
                %thead
                  %tr
                    %th= t('.form', default: 'Form')
                    %th= t('.actions', default: 'Actions')
                %tbody
                  - @available_forms.each do |custom_field|
                    %tr
                      %td= custom_field.form_title
                      %td
                        = link_to new_polymorphic_path([@custom_formable, CustomFieldProperty], custom_field_id: custom_field) do
                          .btn.btn-primary.btn-xs.btn-width= t('.add_form', default: 'Add form')
          - else
            %p.text-muted= t('.no_available_forms', default: 'Every available form has been started.')
- @breakglass_forms.each do |custom_field|
  = render 'clients/break_glass_modal', client: @custom_formable, custom_field: custom_field
