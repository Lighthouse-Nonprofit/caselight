-# UX round 3 (A1) — the Forms partition page. Investor UX round (2026-07): the form NAME is
-# now the entries link ("View entries" button retired) and the available-forms table became
-# an "Add new form" picker in the toolbar. Break-glass locked rows unchanged. Polymorphic
-# (Client + Family — one view serves both hubs).
.row
  .col-12
    - if @custom_formable.is_a?(Client)
      = render 'clients/client_header', client: @custom_formable, active_tab: client_hub_active_tab
    - elsif @custom_formable.is_a?(Family)
      = render 'families/family_header', family: @custom_formable, active_tab: family_hub_active_tab
    - filled_empty = @grouped_forms.empty? && @breakglass_forms.empty?
    %div{ class: ibox_classes(collapsed: filled_empty) }
      .ibox-title
        %h5= t('.filled_forms', default: 'Forms')
        .ibox-tools
          - if can? :manage, CustomFieldProperty
            .dropdown.d-inline-block.forms-add
              - if @available_forms.any?
                %button.btn.btn-primary.btn-xs.dropdown-toggle{ type: 'button', 'data-bs-toggle' => 'dropdown', 'aria-expanded' => 'false' }
                  = t('.add_new_form', default: 'Add new form')
                %ul.dropdown-menu.dropdown-menu-end.forms-add__menu
                  - @available_forms.each do |custom_field|
                    %li= link_to custom_field.form_title, new_polymorphic_path([@custom_formable, CustomFieldProperty], custom_field_id: custom_field), class: 'dropdown-item'
              - else
                %button.btn.btn-primary.btn-xs{ type: 'button', disabled: true, title: t('.no_available_forms', default: 'Every available form has been started.') }
                  = t('.add_new_form', default: 'Add new form')
          = render 'shared/ibox_collapse_link', collapsed: filled_empty
      .ibox-content
        - if @grouped_forms.any? || @breakglass_forms.any?
          .table-responsive
            %table.table.cl-record-table.forms-table
              %thead
                %tr
                  %th= t('.form', default: 'Form')
                  %th= t('.entries', default: 'Entries')
                  %th= t('.latest_entry', default: 'Latest entry')
                  %th= t('.actions', default: 'Actions')
              %tbody
                - @grouped_forms.each do |custom_field_id, props|
                  %tr
                    %td= link_to props.first.custom_field.form_title, polymorphic_path([@custom_formable, CustomFieldProperty], custom_field_id: custom_field_id), class: 'forms-table__name-link'
                    %td= props.size
                    %td= date_format(props.map(&:created_at).max)
                    %td
                      - if can? :manage, CustomFieldProperty
                        = link_to new_polymorphic_path([@custom_formable, CustomFieldProperty], custom_field_id: custom_field_id) do
                          .btn.btn-outline.btn-success.btn-xs.btn-width= t('.add_entry', default: 'Add entry')
                - @breakglass_forms.each do |custom_field|
                  %tr.forms__locked
                    %td
                      %i.fa.fa-lock.text-danger{ 'aria-hidden' => 'true' }
                      = custom_field.form_title
                      %span.text-muted= t('.locked_hint', default: '— access requires a logged reason, 1 hour')
                    %td= t('.locked', default: '—')
                    %td= t('.locked', default: '—')
                    %td
                      %button.btn.btn-xs.btn-outline-danger{ type: 'button', 'data-bs-toggle' => 'modal', 'data-bs-target' => "#break-glass-#{custom_field.id}" }
                        = t('.unlock', default: 'Request access')
        - else
          %p.text-muted= t('.no_forms', default: 'No forms filled yet.')
- @breakglass_forms.each do |custom_field|
  = render 'shared/break_glass_modal', formable: @custom_formable, custom_field: custom_field
