%nav.navbar-default.navbar-static-side{:role => "navigation"}
  .sidebar-collapse
    %ul#side-menu.nav.metismenu
      %li.nav-header
        .dropdown.profile-element
          .image-wrapper.text-center
            = link_to root_path do
              = image_tag('brand/caselight-logo-ondark.png', alt: 'CaseLight', style: 'max-width: 170px; width: 100%; height: auto;')
          %hr.line-border
          -# C1: data-bs-popper-config (BS 5.3 JSON-parses it) pins the menu with Popper's fixed
          -# strategy so it escapes the 70px rail's overflow-x:hidden in mini mode; the glyph is
          -# the icon-only trigger the mini rail shows (hidden expanded — see _sidebar.scss).
          %a.dropdown-toggle{"data-bs-toggle" => "dropdown", :href => "#", "data-bs-popper-config" => '{"strategy":"fixed"}'}
            %i.fa.fa-user.profile-element__glyph{ 'aria-hidden' => 'true' }
            %span.clear
              %span.block.m-t-xs
                %strong.font-bold= current_user.name
              %span.text-muted.text-xs.block
                = current_user.roles
                %i.fa.fa-angle-down{ 'aria-hidden' => 'true' }
          %ul.dropdown-menu.animated.fadeInRight.m-t-xs
            %li
              = link_to t('.edit_profile'), edit_user_registration_path
            %li
              = link_to t('.two_factor', default: 'Two-factor authentication'), two_factor_settings_path
            %li
              = link_to t('.passkeys', default: 'Passkeys'), passkeys_path
            %li.divider
            %li
              = link_to t('.log_out'), destroy_user_session_path, method: :delete
        .logo-element.custom
          = link_to root_path do
            = image_tag('brand/caselight-mark-ondark.png', alt: 'CaseLight', class: 'log-min img-fluid', style: 'max-width: 40px; margin: 0 auto;')
      - if user_signed_in?
        %li{class: "#{active_menu('dashboards')}"}
          = link_to root_path do
            %i.fa.fa-th-large{ 'aria-hidden' => 'true' }
            %span.nav-label= t('.dashboards')

        %li{class: clients_menu_active}
          = link_to clients_path do
            = fa_icon('user', 'aria-hidden': true)
            %span.nav-label= t('.clients')
            %span.badge.text-bg-primary.float-end= @client_count
        -# Schools batch SCH1 — the youth flavor promotes Schools to the main
        -# sidebar (owner: "as important as households"). First structural flavor
        -# branch; other flavors see no entry (and would have no kind=school rows).
        - if Rails.application.config.x.flavor == 'youth' && (can? :read, Agency)
          %li{class: "#{active_menu('schools')}"}
            = link_to schools_path do
              = fa_icon('graduation-cap', 'aria-hidden': true)
              %span.nav-label= t('.schools', default: 'Schools')
          %li{class: "#{active_menu('sites')}"}
            = link_to sites_path do
              = fa_icon('map-marker', 'aria-hidden': true)
              %span.nav-label= t('.sites', default: 'Sites')
        - if can? :read, Family
          %li{class: families_menu_active}
            = link_to families_path do
              = fa_icon('users', 'aria-hidden': true)
              %span.nav-label= t('.families')
              %span.badge.text-bg-primary.float-end= @family_count

        - if can? :read, Partner
          %li{class: partners_menu_active}
            = link_to partners_path do
              = fa_icon('handshake-o', 'aria-hidden': true)
              %span.nav-label= t('.partners')
              %span.badge.text-bg-primary.float-end= @partner_count

        - if can? :read, User
          %li{class: users_menu_active}
            = link_to users_path do
              = fa_icon('address-book-o', 'aria-hidden': true)
              %span.nav-label= t('.users')
              %span.badge.text-bg-primary.float-end= @user_count

        %li
          %a#manage{href: "#"}
            %i.fa.fa-cogs{ 'aria-hidden' => 'true' }
            %span.nav-label= t('.manage')
            %span.fa.arrow{ 'aria-hidden' => 'true' }
          %ul.nav.nav-second-level
            %li{ class: active_menu('agencies') }
              = link_to t('.agencies'), agencies_path
            - if can? :read, :all
              -# D2: Departments hidden for the pilot (owner: possible ERP/org-chart
              -# build-out for larger nonprofits later). Model/table stay dormant.
              %li{ class: active_menu('domains') }
                = link_to t('.domains'), domains_path
              %li{ class: active_menu('domain_groups') }
                = link_to t('.domain_groups'), domain_groups_path
              %li{ class: active_menu('donors') }
                = link_to t('.donors'), donors_path
              %li{ class: active_menu('referral_sources') }
                = link_to t('.referral_sources'), referral_sources_path
              - if can? :index, Referral
                %li{ class: active_menu('referrals') }
                  = link_to t('.referrals_out', default: 'Referrals (out)'), referrals_path
              %li{ class: active_menu('quantitative_types') }
                = link_to t('.quantitative_types'), quantitative_types_path
              %li
                %a#pro-nav{href: "#"}
                  = t('.progress_note')
                  %span.fa.arrow{ 'aria-hidden' => 'true' }
                %ul.nav.nav-third-level
                  %li{ class: active_menu('interventions') }
                    = link_to t('.interventions'), interventions_path
                  %li{ class: active_menu('locations') }
                    = link_to t('.locations'), locations_path
                  %li{ class: active_menu('materials') }
                    = link_to t('.materials'), materials_path
                  %li{ class: active_menu('progress_note_types') }
                    = link_to t('.progress_note_types'), progress_note_types_path
              %li{ class: active_menu('custom_fields') }
                = link_to t('.custom_fields'), custom_fields_path
              %li{ class: active_menu('program_streams') }
                - if current_user.program_warning?
                  = link_to t('.program_streams'), program_streams_path
                - else
                  %a{"data-bs-target" => "#warning-program", "data-bs-toggle" => "modal", :type => "button"}=t('.program_streams')
              %li{ class: active_menu('changelogs') }
                = link_to t('.release_logs'), changelogs_path
            - else
              - if can? :read, CustomField
                %li{ class: active_menu('custom_fields') }
                  = link_to t('.custom_fields'), custom_fields_path
              - if can? :read, ProgramStream
                %li{ class: active_menu('program_streams') }
                  - if current_user.program_warning?
                    = link_to t('.program_streams'), program_streams_path
                  - else
                    %a{"data-bs-target" => "#warning-program", "data-bs-toggle" => "modal", :type => "button"}=t('.program_streams')
              - if can? :read, ReferralSource
                %li{ class: active_menu('referral_sources') }
                  = link_to t('.referral_sources'), referral_sources_path
              - if can? :index, Referral
                %li{ class: active_menu('referrals') }
                  = link_to t('.referrals_out', default: 'Referrals (out)'), referrals_path
        -# Investor UX round (2026-07): the Reports landing page — admin + strategic overviewer
        -# (can? :index, :report mirrors ReportsController's authorize_resource class: false).
        - if can? :index, :report
          %li{ class: active_menu('reports') }
            = link_to reports_path do
              = fa_icon('bar-chart', 'aria-hidden': true)
              %span.nav-label= t('.reports')
        - if can? :read, DataTracker
          %li{ class: active_menu('data_trackers') }
            = link_to data_trackers_path do
              = fa_icon('area-chart', 'aria-hidden': true)
              %span.nav-label= t('.changelogs')
        -# Phase 5 capstone — admin-only AC-2/AC-3 security surfaces. Both gated on the SAME :manage that the
        -# enforcement-settings controller authorizes, so only admin sees them (no new role checks needed).
        - if can? :manage, EnforcementSetting
          %li{ class: active_menu('access_reviews') }
            = link_to access_review_path do
              = fa_icon('check-square-o', 'aria-hidden': true)
              %span.nav-label= t('.access_review')
          %li{ class: active_menu('enforcement_settings') }
            = link_to enforcement_settings_path do
              = fa_icon('shield', 'aria-hidden': true)
              %span.nav-label= t('.enforcement_settings')
