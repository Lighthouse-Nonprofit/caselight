= render 'clients/client_header', client: @client, active_tab: client_hub_active_tab
.row
  .col-12
    .ibox
      .ibox-title
        %h5= "#{@client.en_and_local_name} - #{t('.exit_date')} #{date_format(@leave_program.exit_date)}"
        .ibox-tools
          - if can? :manage, LeaveProgram
            = link_to edit_client_client_enrollment_leave_program_path(@client, @enrollment, @leave_program, program_stream_id: @program_stream) do
              .btn.btn-success.btn-outline
                = fa_icon('pencil')
          = link_to client_client_enrollments_path(@client, program_stream_id: @program_stream) do
            .btn.btn-outline-secondary.btn-back-default
              = t('.back')
      .ibox-content
        -# UX round 4 (R4-4): field table -> the info grid (user-authored labels = natural case).
        = render 'shared/info_grid', items: custom_field_info_items(@program_stream.exit_program, @leave_program), variant: 'info-grid--natural-case'
