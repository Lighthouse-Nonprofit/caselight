%p Dear Managers,
%p= "#{pluralize(@clients.count, 'client')} #{'has'.pluralize(@clients.count)} been enrolled in a priority-intake program for #{@day} days."
%p
  = "Click"
  = link_to 'here', clients_url('client_grid[status]':'Active EC', 'client_grid[case_type]':'EC', 'client_grid[placement_date]': [(Date.today-@day.to_i).strftime('%Y-%m-%d'), (Date.today-@day.to_i).strftime('%Y-%m-%d')], subdomain: Organization.current.short_name), target: :_blank
  = "to see the full list."
%p To review an individual client, use the links below.
- @clients.each do |client|
  - name = client.name.blank? ? 'Unknown' : client.name
  %p= link_to name, client_url(client, subdomain: Organization.current.short_name), target: :_blank

%p Thanks,

%p The CaseLight Team
