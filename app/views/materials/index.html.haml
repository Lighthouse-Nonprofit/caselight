.row
  .col-12
    .ibox
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.material')
        .ibox-tools
          - if can? :manage, Material
            = link_to '#', {"data-bs-target" => "#materialModal-", "data-bs-toggle" => "modal", :type => "button"} do
              .btn.btn-primary.btn-add
                = t('.add_new_material')
      .ibox-content
        .table-responsive
          %table.table.table-bordered.table-striped.table-hover
            %thead
              %tr
                %th= t('.status')
                - if can? :manage, Material
                  %th.text-center{:colspan => "2"}
                    = t('.manage')
                - if can? :version, Material
                  %th.text-center= t('.changelogs')
            %tbody
              - @materials.each do |material|
                %tr
                  %td= material.status
                  - if can? :manage, Material
                    %td.text-center
                      = link_to '#', {class: 'btn btn-xs btn-outline btn-success', "data-bs-target" => "#materialModal-#{material.id}", "data-bs-toggle" => "modal", :type => "button"} do
                        = fa_icon('pencil')
                    %td.text-center
                      = remove_link(material, { material_progress_note: material.progress_notes.count })
                  - if can? :version, Material
                    %td.text-center
                      = link_to t('.view'), material_version_path(material)
                = render 'form', material: material

      .ibox-footer.text-center
        = paginate @materials
= render 'form'
