= render 'shared/page_header',
  title: t('.title', default: 'Partners'),
  filter_target: '#partner-search-form',
  primary: ((can? :manage, Partner) ? { label: t('partners.index.add_new_partner'), url: new_partner_path, class: 'btn-partner' } : nil),
  secondary: [{ label: t('partners.index.export_xls'), url: current_url(format: 'xls'), class: 'btn-export' }]
.row
  .col-12
    = applied_filter_chips(:partner_grid, scope: 'partners')
.row.ibox-space
  .col-12
    .ibox.float-e-margins#partner-search-form.collapse
      .ibox-content
        = datagrid_form_for @partner_grid, url: partners_url, html: { class: 'grid-form' }
.row
  .col-12
    .ibox.float-e-margins
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.results')
      .ibox-content
        .partners-table
          = datagrid_table @partner_grid, html: { class: 'table table-bordered table-striped table-hover partners'}
      .ibox-footer.text-center
        = paginate @partner_grid.assets
