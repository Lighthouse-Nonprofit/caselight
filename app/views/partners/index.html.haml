.row
  .col-12
    .float-start
      %button.btn.btn-primary.btn-filter{"aria-expanded" => 'false', "aria-label" => t('shared.actions.filter', default: 'Toggle search filters'), "data-bs-target" => '#partner-search-form', "data-bs-toggle" => 'collapse', type: 'button'}
        %i.fa.fa-filter{"aria-hidden" => "true"}
    .float-end
      - if can? :manage, Partner
        = link_to "#{I18n.t('partners.index.add_new_partner')}", new_partner_path, class: 'btn btn-primary btn-partner'
      = link_to "#{I18n.t('partners.index.export_xls')}", current_url(format: 'xls'), class: 'btn btn-info btn-export'
.row.ibox-space
  .col-12
    .ibox.float-e-margins#partner-search-form.collapse
      .ibox-content
        = datagrid_form_for @partner_grid, url: partners_url, html: { class: 'grid-form' }
.row
  .col-12
    .ibox.float-e-margins
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.results')
      .ibox-content
        .partners-table
          = datagrid_table @partner_grid, html: { class: 'table table-bordered table-striped table-hover partners'}
      .ibox-footer.text-center
        = paginate @partner_grid.assets
