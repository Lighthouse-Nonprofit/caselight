-# POAM-019 (PR B2) — the smoke template that keeps the PdfRenderer surface WARM and doubles as
-# the reporting example: render via
-#   PdfRenderer.render_template(template: 'pdf/smoke', assigns: { title: ..., rows: [[..], ..] })
-# Not routed, not linked — exercised by spec/lib/pdf_renderer_spec.rb (and future reporting
-# templates copy this shape: assigns in, self-contained markup out).
- content_for(:pdf_title) { @title.to_s }
%h1= @title
.pdf-meta Generated by CaseLight · PdfRenderer smoke template
%hr.pdf-rule/
%h2 Sample table
%table
  %thead
    %tr
      %th Column A
      %th Column B
  %tbody
    - Array(@rows).each do |a, b|
      %tr
        %td= a
        %td= b
