.check-box-group
  .row
    .col-12.mb-3{ class: html_column(full_width) }
      %label= field_props['label']
      - field_props['values'].each do |field|
        %li
          = check_box_tag :nil, field['label'], field['selected'], { class: 'form-check-input' }
          = label_tag '', field['label']