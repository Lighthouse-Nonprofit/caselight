= render 'shared/page_header',
  title: t('.title', default: 'Progress Notes'),
  filter_target: '#progress-note-search-form',
  primary: ((can? :manage, ProgressNote) ? { label: t('.add_new_progress_note'), url: new_client_progress_note_path(@client), class: "btn-add #{ability_to_write(ProgressNote)}".strip } : nil),
  secondary: [{ label: t('.export_to_xls'), url: current_url(format: 'xls'), class: 'btn-export' }]
.row
  .col-12
    = applied_filter_chips(:progress_note_grid, scope: 'progress_notes')

.row
  .col-12
    .ibox#progress-note-search-form.collapse
      .ibox-content
        = datagrid_form_for @progress_note_grid, url: client_progress_notes_url(@client), html: { class: 'grid-form' }
.row
  .col-12
    .ibox
      .ibox-title
        %h5
          %strong= @progress_note_grid.assets.count
        %span.badge.text-bg-info= t('.results')
        .ibox-tools
          = link_to client_path(@client), class: 'btn btn-outline-secondary btn-back-default' do
            = t('.back')
      .ibox-content
        .progress_notes-table
          = datagrid_table @progress_note_grid, html: {class: 'table table-bordered table-striped table-hover progress-notes'}
.row
  .col-12.text-center
    = paginate @progress_note_grid.assets
