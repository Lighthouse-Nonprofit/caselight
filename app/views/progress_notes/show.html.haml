.row
  .col-12
    = render 'clients/client_header', client: @client, active_tab: :progress_notes
.row
  .col-12
    .ibox
      .ibox-title
        %h5= @progress_note.date.strftime('%d %B, %Y')
        .ibox-tools
          %a.collapse-link
            .btn.btn-outline.btn-primary
              %i.fa.fa-chevron-up
          - if can? :manage, ProgressNote
            = link_to edit_client_progress_note_path(@client, @progress_note), class: "btn btn-outline btn-success #{ability_to_update(ProgressNote)}" do
              = fa_icon('pencil')
            = link_to [@client, @progress_note], method: 'delete', data: { confirm: t('.are_you_sure') }, class: "btn btn-outline btn-danger #{ability_to_delete(ProgressNote)}" do
              = fa_icon('trash')
      .ibox-content
        -# UX round 4 (R4-4): the bordered table becomes the info grid; narrative rich-text +
        -# the attachments listing render as full-width items (the attachments LIST stays a
        -# real table — per-row download buttons, idiom 3).
        - items = []
        - items << info_item(t('.child'), @progress_note.client)
        - items << info_item(t('.staff'), @progress_note.user)
        - items << info_item(t('.progress_note_type'), @progress_note.progress_note_type)
        - items << info_item(t('.location'), @progress_note.location)
        - items << info_item(t('.other_location'), @progress_note.other_location)
        - items << info_item(t('.interventions'), (@progress_note.interventions.pluck(:action).join(', ') if @progress_note.interventions.any?))
        - items << info_item(t('.material'), @progress_note.material)
        - goals_html = capture do
          - if @progress_note.assessment_domains.any?
            - visible_ads = @progress_note.assessment_domains.includes(:domain).select { |ad| domain_visible?(ad) }
            - hidden_ad_count = @progress_note.assessment_domains.size - visible_ads.size
            = visible_ads.map(&:goal).join(', ')
            = masked_hidden_notice(hidden_ad_count)
        - items << info_item(t('.goals_addressed'), goals_html.presence)
        - items << info_item(t('.response'), render_rich_text(@progress_note.response), full: true)
        - items << info_item(t('.additional_notes'), render_rich_text(@progress_note.additional_note), full: true)
        - if @progress_note.attachments.any?
          - attachments_html = capture do
            %table.table.attachments
              - @progress_note.attachments.each do |attachment|
                %tr
                  %td= original_filename(attachment)
                  %td.text-center= link_to preview_or_download(attachment), authorized_download_path('attachment', attachment.id, 'file', **inline_view_params(attachment)), class: 'btn btn-info btn-sm btn-download', target: target_blank(attachment), rel: noopener_for(attachment)
          - items << info_item(t('.attachments'), attachments_html, full: true)
        = render 'shared/info_grid', items: items

      .ibox-footer
        .row
          .col-12
            = link_to t('.back'), client_progress_notes_path(@client), class: 'btn btn-outline-secondary btn-back'
