= simple_form_for(quantitative_type ||= QuantitativeType.new) do |f|
  .modal.fade{id: "quantitative_typeModal-#{quantitative_type.id}", "aria-labelledby" => "quantitative_typeModal-#{quantitative_type.id}Label", :role => "dialog", :tabindex => "-1"}
    .modal-dialog{:role => "document"}
      .modal-content
        .modal-header
          %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", :type => "button"}
          %h4.modal-title{ id: "quantitative_typeModal-#{quantitative_type.id}Label" }= t('.quantitative_type')
        .modal-body
          = error_notification(f)
          .form-inputs
            = f.input :name, label: t('.name')
            -# D3: description (column + permit always existed; the input never did) doubles
            -# as the help text under the client-form select. allow_multiple = single vs multi.
            = f.input :description, input_html: { rows: '4' }, label: t('.description', default: 'Description (shown as help text on the individual form)')
            = f.input :allow_multiple, as: :boolean, label: t('.allow_multiple', default: 'Allow selecting more than one value per person')
            = f.simple_fields_for :quantitative_cases do |quantitative_case|
              = render 'quantitative_case_fields', f: quantitative_case
          .links
            = link_to_add_association t('.add_quantitative_data'), f, :quantitative_cases, class: 'btn btn-info add-more'
        .modal-footer
          .float-start
            = f.submit t('.save') , class: 'btn btn-primary form-btn'
            %button.btn.btn-outline.btn-outline-secondary{"data-bs-dismiss" => "modal", :type => "button"}= t('.cancel')
