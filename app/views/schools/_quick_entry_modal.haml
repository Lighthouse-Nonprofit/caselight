-# HUB2 — per-youth quick entry (the add_program_modal pattern: pure
-# data-bs-toggle + a normal single-row POST to the EXISTING report-cards
-# endpoint; blank modal saves nothing). Locals: school:, client:, prefill:.
- key = "report_cards[#{client.id}]"
.modal.fade{ id: "quick-entry-#{client.id}", tabindex: '-1', 'aria-hidden' => 'true', 'aria-labelledby' => "quick-entry-label-#{client.id}" }
  .modal-dialog
    .modal-content
      = form_with url: report_cards_school_path(school), method: :post, local: true do
        .modal-header
          %h5.modal-title{ id: "quick-entry-label-#{client.id}" }
            = t('schools.quick_entry.title', name: client.name, default: "Quick entry — #{client.name}")
          %button.btn-close{ type: 'button', 'data-bs-dismiss' => 'modal', 'aria-label' => t('schools.quick_entry.close', default: 'Close') }
        .modal-body
          .mb-3
            %label.form-label= t('schools.report_cards.report_date', default: 'Report date')
            %input.form-control{ type: 'date', name: 'report_date', value: Time.zone.today.iso8601, required: true }
          .mb-3
            %label.form-label= t('schools.report_cards.gpa', default: 'GPA (x100)')
            %input.form-control{ type: 'number', name: "#{key}[gpa]", min: 0, max: 400, placeholder: prefill['GPA (x100, e.g. 275 = 2.75)'] }
          .mb-3
            %label.form-label= t('schools.report_cards.attendance', default: 'Attendance %')
            %input.form-control{ type: 'number', name: "#{key}[attendance]", min: 0, max: 100, placeholder: prefill['School-Day Attendance % (this period)'] }
          .mb-3
            %label.form-label= t('schools.report_cards.ag', default: 'A-G')
            %select.form-select{ name: "#{key}[ag]" }
              %option{ value: '' }
              - ['On track', 'At risk', 'Off track', 'N/A'].each do |v|
                %option{ value: v }= v
          .mb-3
            %label.form-label= t('schools.report_cards.notes', default: 'Notes')
            %input.form-control{ type: 'text', name: "#{key}[notes]" }
        .modal-footer
          %button.btn.btn-outline-secondary{ type: 'button', 'data-bs-dismiss' => 'modal' }= t('schools.quick_entry.cancel', default: 'Cancel')
          %button.btn.btn-primary{ type: 'submit' }= t('schools.quick_entry.save', default: 'Save')
