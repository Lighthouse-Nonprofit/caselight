-# S3 — report cards ON FILE for this school: saved records, newest first, each
-# editable through the standard tracking form. "New report cards" opens the
-# batch grid for a report date.
= render 'schools/school_header', school: @school, active_tab: nil
= render 'shared/page_header', title: t('.title', default: 'Report cards'),
                               primary: { label: t('.new', default: 'New report cards'),
                                          url: new_report_cards_school_path(@school) }
.row.mini-margin
  .col-12
    .ibox
      .ibox-content
        - if @entries.empty?
          %p.text-muted.mb-0= t('.none', default: 'No report cards on file yet. Use “New report cards” to enter a term.')
        - else
          .cl-table-scroll
            %table.table.cl-record-table
              %thead
                %tr
                  %th= t('.col_youth', default: 'Youth')
                  %th= t('.col_date', default: 'Report date')
                  %th= t('.col_gpa', default: 'GPA')
                  %th= t('.col_attendance', default: 'Attendance %')
                  %th= t('.col_credits', default: 'Credits')
                  %th= t('.col_ag', default: 'A-G')
                  %th= t('.col_discipline', default: 'Discipline')
                  %th
              %tbody
                - @entries.each do |entry|
                  %tr
                    %td
                      - if entry.client
                        = link_to entry.client.name, client_path(entry.client)
                    %td= entry.report_date.strftime('%b %d, %Y')
                    %td= entry.gpa_display || '—'
                    %td= entry.values[Schools::ReportCards::FIELDS[:attendance]].presence || '—'
                    %td= entry.values[Schools::ReportCards::FIELDS[:credits]].presence || '—'
                    %td= entry.values[Schools::ReportCards::FIELDS[:ag]].presence || '—'
                    %td= entry.values[Schools::ReportCards::FIELDS[:discipline]].presence || '—'
                    %td.text-right
                      - if entry.client && entry.enrollment
                        = link_to t('.edit', default: 'Edit'),
                                  edit_client_client_enrollment_client_enrollment_tracking_path(entry.client, entry.enrollment, entry.record, tracking_id: entry.record.tracking_id),
                                  class: 'btn btn-outline-primary btn-xs'
          %p.text-muted.small.m-t-sm.mb-0= t('.edit_hint', default: 'Editing opens the youth’s report card form; saving returns to their Programs tab.')
