-# SCH2/HUB2 — bulk report-card entry: one row per PV-enrolled youth. Blank
-# rows create nothing; PLACEHOLDERS show each youth's latest values and are
-# never submitted (placeholder, not value). Sticky youth column via
-# .schools-entry-grid. Zero page JS (body-id underscore gotcha).
= render 'schools/school_header', school: @school, active_tab: nil
= render 'shared/page_header', title: t('.title', default: 'Report card entry')
.row.mini-margin
  .col-12
    .ibox
      .ibox-content
        - if @rows.empty?
          %p.text-muted.mb-0= t('.no_rows', default: 'No youths on your caseload have an active ¡Por Vida! enrollment at this school.')
        - else
          %p.text-muted
            = t('.youth_count', count: @rows.size, default: "#{@rows.size} youth")
            ·
            = t('.rows_hint', default: 'Only rows with data will be saved.')
          = form_with url: report_cards_school_path(@school), method: :post, local: true do
            .row.gy-2.gx-2.align-items-end.m-b-sm
              .col-auto
                .mb-3
                  %label.form-label{ for: 'report-date' }= t('.report_date', default: 'Report date')
                  %input#report-date.form-control{ type: 'date', name: 'report_date', value: Time.zone.today.iso8601, required: true }
            .cl-table-scroll.schools-entry-grid
              %table.table.cl-record-table
                %thead
                  %tr
                    %th= t('.youth', default: 'Youth')
                    %th= t('.gpa', default: 'GPA (x100)')
                    %th= t('.credits', default: 'Credits')
                    %th= t('.ag', default: 'A-G')
                    %th= t('.attendance', default: 'Attendance %')
                    %th= t('.discipline', default: 'Discipline')
                    %th= t('.notes', default: 'Notes')
                %tbody
                  - @rows.each do |enrollment|
                    - key = "report_cards[#{enrollment.client_id}]"
                    - prefill = @prefills.fetch(enrollment.client_id, {})
                    %tr
                      %td= enrollment.client.name
                      %td
                        %input.form-control.form-control-sm{ type: 'number', name: "#{key}[gpa]", min: 0, max: 400, placeholder: prefill['GPA (x100, e.g. 275 = 2.75)'] }
                      %td
                        %input.form-control.form-control-sm{ type: 'number', name: "#{key}[credits]", min: 0, placeholder: prefill['Credits Earned (cumulative)'] }
                      %td
                        %select.form-select.form-select-sm{ name: "#{key}[ag]" }
                          %option{ value: '' }
                          - ['On track', 'At risk', 'Off track', 'N/A'].each do |v|
                            %option{ value: v }= v
                        - if prefill['A-G On Track'].present?
                          %small.text-muted= t('.last_value', value: prefill['A-G On Track'], default: "last: #{prefill['A-G On Track']}")
                      %td
                        %input.form-control.form-control-sm{ type: 'number', name: "#{key}[attendance]", min: 0, max: 100, placeholder: prefill['School-Day Attendance % (this period)'] }
                      %td
                        %input.form-control.form-control-sm{ type: 'number', name: "#{key}[discipline]", min: 0, placeholder: prefill['Discipline Incidents (this period)'] }
                      %td
                        %input.form-control.form-control-sm{ type: 'text', name: "#{key}[notes]" }
            %button.btn.btn-primary{ type: 'submit' }= t('.save', default: 'Save report cards')
