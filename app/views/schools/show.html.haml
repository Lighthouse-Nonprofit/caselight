-# HUB1 — the school Overview tab: stat tiles (dashboards pattern), info grid,
-# recent activity (service-dated, the Y2 rule).
= render 'schools/school_header', school: @school, active_tab: :overview
.row
  .col-lg-3.col-sm-6
    .ibox
      .ibox-content.text-center
        %h1.font-bold.m-b-none= @hub_youth_count
        %small.text-muted= t('schools.show.tile_youth', default: 'YOUTH LINKED')
  .col-lg-3.col-sm-6
    .ibox
      .ibox-content.text-center
        %h1.font-bold.m-b-none= @hub_pv_count
        %small.text-muted= t('schools.show.tile_active_pv', default: 'ACTIVE ¡POR VIDA!')
  .col-lg-3.col-sm-6
    .ibox
      .ibox-content.text-center
        %h1.font-bold.m-b-none= @cohort_youth_count
        %small.text-muted= t('schools.show.tile_cohort_youth', default: 'COHORT YOUTH THIS TERM')
  .col-lg-3.col-sm-6
    .ibox
      .ibox-content.text-center
        %h1.font-bold.m-b-none= @entries_this_month
        %small.text-muted= t('schools.show.tile_service_entries', default: 'SERVICE ENTRIES THIS MONTH')
.row.mini-margin
  .col-12
    .ibox
      .ibox-content
        - items = []
        - items << info_item(t('schools.show.info_description', default: 'About'), @school.description)
        - mix = @active_enrollments.sort.map { |name, count| "#{name} #{count}" }.join(' · ')
        - items << info_item(t('schools.show.info_program_mix', default: 'Active enrollments'), mix.presence)
        = render 'shared/info_grid', items: items
.row.mini-margin
  .col-12
    .ibox
      .ibox-title
        %h5= t('schools.show.recent_activity', default: 'Recent activity')
      .ibox-content
        - if @recent_entries.empty?
          %p.text-muted.mb-0= t('schools.show.no_activity', default: 'No service entries yet.')
        - else
          .table-responsive
            %table.table.table-striped.m-b-none
              %thead
                %tr
                  %th= t('schools.show.col_individual', default: 'Youth')
                  %th= t('schools.show.col_program', default: 'Program')
                  %th= t('schools.show.col_update', default: 'Update')
                  %th.text-right= t('schools.show.col_logged', default: 'Logged')
              %tbody
                - @recent_entries.each do |entry|
                  - enrollment = entry.client_enrollment
                  %tr
                    %td= link_to enrollment.client.name, client_path(enrollment.client)
                    %td= enrollment.program_stream.try(:name)
                    %td= entry.tracking.try(:name)
                    %td.text-right= entry.entry_date.strftime('%b %d, %Y')
