.row
  .col-12
    .ibox
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.site')
        .ibox-tools
          - if can? :manage, Agency
            = link_to '#', {"data-bs-target" => "#siteModal-", "data-bs-toggle" => "modal", :type => "button"} do
              .btn.btn-primary.btn-add
                = t('.add_new_site')
      .ibox-content
        %p.text-muted.small= t('.blurb')
        .table-responsive
          %table.table.table-bordered.table-striped.table-hover
            %thead
              %tr
                %th= t('.site_name')
                %th= t('.type', default: 'Type')
                %th.text-center= t('.programs', default: 'Programs')
                %th= t('.description')
                - if can? :manage, Agency
                  %th.text-center{ colspan: '2' }= t('.manage')
            %tbody
              - @sites.each do |site|
                - twin = @school_twins[site.name.to_s.downcase]
                %tr
                  %td= link_to site.name, site_path(site)
                  %td
                    - if twin
                      = link_to t('.campus_school', default: 'Campus — also a school'), school_path(twin), class: 'badge text-bg-primary text-decoration-none'
                    - else
                      %span.badge.text-bg-secondary= t('.community', default: 'Community site')
                  %td.text-center= @program_counts.fetch(site.id, 0)
                  %td= site.description
                  - if can? :manage, Agency
                    %td.text-center
                      = link_to '#', {class: 'btn btn-outline btn-success btn-xs', "data-bs-target" => "#siteModal-#{site.id}", "data-bs-toggle" => "modal", :type => "button"} do
                        = fa_icon('pencil')
                    %td.text-center
                      = button_to site_path(site), method: :delete, class: 'btn btn-outline btn-danger btn-xs', form: { data: { turbo_confirm: t('.confirm_delete') } } do
                        = fa_icon('trash', 'aria-hidden': true)
                  - if can? :manage, Agency
                    = render 'form', site: site
        .ibox-footer.text-center
          = paginate @sites
= render 'form'
