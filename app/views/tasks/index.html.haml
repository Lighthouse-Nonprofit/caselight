.row
  .col-12
    - if can? :read, Task
      - unless current_user.case_worker?
        .card
          .card-body
            = render 'filter'
    - if params[:user_id] || current_user.case_worker? || current_user.any_case_manager? || current_user.able_manager?
      .ibox
        .ibox-title
          %h5= "#{t('.tasks_of')} #{@user.first_name}" if @user
        .ibox-content
          .card
            .card-header
              .row
                .col-6
                  %h5= t('.overdue_tasks')
            .card-body
              - grouped_tasks = @tasks.overdue.group_by do |task|
                - task.client
              - grouped_tasks.each do |client, tasks|
                .ibox.border-left-right.border-bottom
                  .ibox-title
                    %h5= client.name
                  .ibox-content.no-padding
                    %table.table
                      - tasks.each do |task|
                        %tr
                          %td= "#{t('.domain')} #{task.domain.name} #{task.domain.identity}"
                          %td.task-name.border-left-right= task.name
                          %td= task.completion_date.strftime("%B %d, %Y")
          .card
            .card-header
              .row
                .col-6
                  %h5= t('.today_tasks')
            .card-body
              - grouped_tasks = @tasks.today.group_by do |task|
                - task.client
              - grouped_tasks.each do |client, tasks|
                .ibox.border-left-right.border-bottom
                  .ibox-title
                    %h5= client.name
                  .ibox-content.no-padding
                    %table.table
                      - tasks.each do |task|
                        %tr
                          %td= "#{t('.domain')} #{task.domain.name} #{task.domain.identity}"
                          %td.task-name.border-left-right= task.name
                          %td= task.completion_date.strftime("%B %d, %Y")
          .card
            .card-header
              .row
                .col-6
                  %h5= t('.upcoming_tasks')
            .card-body
              - grouped_tasks = @tasks.upcoming.group_by do |task|
                - task.client
              - grouped_tasks.each do |client, tasks|
                .ibox.border-left-right.border-bottom
                  .ibox-title
                    %h5= client.name
                  .ibox-content.no-padding
                    %table.table
                      - tasks.each do |task|
                        %tr
                          %td= "#{t('.domain')} #{task.domain.name} #{task.domain.identity}"
                          %td.task-name.border-left-right= task.name
                          %td= task.completion_date.strftime("%B %d, %Y")
