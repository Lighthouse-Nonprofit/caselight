.row
  .col-12.clients
    .ibox
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.results')
      .ibox-content
        .clients-table
          = datagrid_table @client_grid, html: { class: 'table table-bordered table-striped table-hover clients'}
      .ibox-footer.text-center
        = paginate @client_grid.assets
