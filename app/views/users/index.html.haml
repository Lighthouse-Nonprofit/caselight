= render 'shared/page_header',
  title: t('.title', default: 'Users'),
  filter_target: '#user-search-form',
  primary: ((can? :manage, :all) ? { label: t('users.index.add_new_user'), url: new_user_path } : nil),
  secondary: [{ label: t('users.index.export_xls'), url: current_url(format: 'xls'), class: 'btn-export' }]
.row
  .col-12
    = applied_filter_chips(:user_grid, scope: 'users')
.row.ibox-space
  .col-12
    .ibox.float-e-margins#user-search-form.collapse
      .ibox-content
        = datagrid_form_for @user_grid, url: users_url, html: { class: 'grid-form' }
.row
  .col-12
    .ibox.float-e-margins
      .ibox-title
        %h5= @results
        %span.badge.text-bg-info= t('.results')
        .ibox-tools
          %a.collapse-link{"aria-label" => t('shared.actions.collapse', default: 'Collapse card')}
            %i.fa.fa-chevron-up{"aria-hidden" => "true"}
          %a.fullscreen-link{"aria-label" => t('shared.actions.fullscreen', default: 'Toggle fullscreen')}
            %i.fa.fa-expand{"aria-hidden" => "true"}
      .ibox-content
        .users-table
          = datagrid_table @user_grid, html: { class: 'table table-bordered table-striped table-hover users'}
      .ibox-footer.text-center
        = paginate @user_grid.assets
