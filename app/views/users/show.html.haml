.row
  .col-12.user
    .btn-group.small-btn-margin
      %button.btn-sm.btn.btn-success.dropdown-toggle{ 'data-bs-toggle' => 'dropdown', class: ('disabled' if @group_user_custom_fields.empty?) }
        = t('.additional_forms')
      %ul.dropdown-menu.scrollable-dropdown-menu
        - @group_user_custom_fields.each do |_, user_custom_fields|
          %li= link_to user_custom_fields.first.custom_field.form_title, user_custom_field_properties_path(@user, custom_field_id: user_custom_fields.first.custom_field_id)

    - if can? :manage, CustomFieldProperty
      .btn-group.small-btn-margin
        %button.btn-sm.btn.btn-primary.dropdown-toggle{ 'data-bs-toggle' => 'dropdown', class: ('disabled' if @free_user_forms.empty?) }
          = t('.add_form')
        %ul.dropdown-menu.scrollable-dropdown-menu
          - @free_user_forms.each do |custom_field|
            %li= link_to custom_field.form_title, new_user_custom_field_property_path(@user, custom_field_id: custom_field.id)
    .ibox.mini-margin
      .ibox-title
        %h5= "#{t('.general_info')} #{@user.name}"
        .ibox-tools
          = render 'shared/ibox_collapse_link'
          - if can? :manage, :all
            %small
              = link_to edit_user_path(@user) do
                .btn.btn-outline.btn-success
                  %i.fa.fa-pencil
              -# Admin user management (owner ask 2026-08): unlock a locked account + reset the password.
              - if @user.respond_to?(:access_locked?) && @user.access_locked?
                = link_to user_unlock_path(@user), method: :patch, data: { confirm: t('.confirm_unlock', default: 'Unlock this account so the user can sign in again?') } do
                  .btn.btn-outline.btn-warning{ title: t('.unlock', default: 'Unlock account') }
                    %i.fa.fa-unlock
              = link_to user_reset_password_path(@user), method: :patch, data: { confirm: t('.confirm_reset_password', default: 'Reset this user’s password to a new temporary one?') } do
                .btn.btn-outline.btn-info{ title: t('.reset_password', default: 'Reset password') }
                  %i.fa.fa-key
              = remove_link(@user, {user_case: @user.cases_count}, 'btn-md')

      .ibox-content
        -# UX round 4 (R4-4): the bordered table becomes the info grid (label text unchanged).
        .user-summary
          - items = []
          - items << info_item(t('.job_title'), @user.job_title)
          - items << info_item(t('.manager'), @user.manager.try(:name))
          - items << info_item(t('.mobile'), (@user.mobile.phony_formatted(normalize: :KH, format: :international) if @user.mobile))
          - emails_html = capture do
            - (@user.email ? @user.email.split(%r{;\s*}) : []).each do |object_email|
              = mail_to object_email
          - items << info_item(t('.email'), emails_html.presence)
          - items << info_item(t('.date_of_birth'), date_format(@user.date_of_birth))
          - items << info_item(t('.start_date'), date_format(@user.start_date))
          - items << info_item(t('.pin_number'), @user.pin_number)
          = render 'shared/info_grid', items: items
= render 'clients'
